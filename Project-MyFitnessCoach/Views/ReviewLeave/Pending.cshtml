@using Project_MyFitnessCoach.Models.ViewModels
@model PendingReviewListViewModel

@{
    ViewData["Title"] = "待我審核";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2>
                <i class="bx bx-check-double"></i> @ViewData["Title"]
                <span class="badge badge-warning">@Model.PendingCount</span>
            </h2>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row">
        @await Html.PartialAsync("_StatCard", ("待審核總計", Model.PendingCount.ToString(), "bx bx-time-five", "warning"))
        @await Html.PartialAsync("_StatCard", ("新假單", Model.NewLeaveCount.ToString(), "bx bx-calendar-plus", "primary"))
        @await Html.PartialAsync("_StatCard", ("取消請求", Model.CancelRequestCount.ToString(), "bx bx-revision", "info"))
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle mr-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- 類型切換 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-2">
            <div class="btn-group" role="group">
                <a asp-action="Pending" class="btn btn-sm @(string.IsNullOrEmpty(Model.TypeFilter) ? "btn-primary" : "btn-outline-primary")">
                    全部 (@Model.PendingCount)
                </a>
                <a asp-action="Pending" asp-route-typeFilter="new" class="btn btn-sm @(Model.TypeFilter == "new" ? "btn-primary" : "btn-outline-primary")">
                    新假單 (@Model.NewLeaveCount)
                </a>
                <a asp-action="Pending" asp-route-typeFilter="cancel" class="btn btn-sm @(Model.TypeFilter == "cancel" ? "btn-info" : "btn-outline-info")">
                    取消請求 (@Model.CancelRequestCount)
                </a>
            </div>
        </div>
    </div>

    <!-- 審核列表 -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th>單號</th>
                            <th>申請人</th>
                            <th>類型</th>
                            <th>假別</th>
                            <th>請假日期</th>
                            <th>時數 / 天數</th>
                            <th>原因</th>
                            <th>代理人</th>
                            <th>申請時間</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Requests != null && Model.Requests.Any())
                        {
                            foreach (var req in Model.Requests)
                            {
                                <tr class="text-center">
                                    <td>@req.Id</td>
                                    <td>@req.ApplicantName</td>
                                    <td>
                                        @if (req.IsCancelRequest)
                                        {
                                            <span class="badge badge-info">取消請求</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-primary">新假單</span>
                                        }
                                    </td>
                                    <td>@req.LeaveTypeName</td>
                                    <td>@req.StartDate.ToString("yyyy-MM-dd") ~ @req.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td>@req.HoursUsed.ToString("0.#")h / @req.DaysUsed.ToString("0.#")天</td>
                                    <td class="text-left" style="max-width:150px;">
                                        @if (req.IsCancelRequest)
                                        {
                                            <small class="text-muted">取消原因：</small><br />
                                            <span>@req.CancelReason</span>
                                        }
                                        else
                                        {
                                            <span title="@req.Reason">@(req.Reason?.Length > 20 ? req.Reason.Substring(0, 20) + "..." : req.Reason)</span>
                                        }
                                    </td>
                                    <td>@(req.DelegateName ?? "-")</td>
                                    <td>@req.CreatedAt.ToString("MM-dd HH:mm")</td>
                                    <td>
                                        @if (req.IsCancelRequest)
                                        {
                                            <button type="button" class="btn btn-sm btn-success"
                                                    data-toggle="modal" data-target="#approveCancelModal-@req.Id">
                                                <i class="bx bx-check"></i> 核准取消
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    data-toggle="modal" data-target="#rejectCancelModal-@req.Id">
                                                <i class="bx bx-x"></i> 駁回取消
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-success"
                                                    data-toggle="modal" data-target="#approveModal-@req.Id">
                                                <i class="bx bx-check"></i> 核准
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    data-toggle="modal" data-target="#rejectModal-@req.Id">
                                                <i class="bx bx-x"></i> 駁回
                                            </button>
                                        }
                                        <a asp-action="Detail" asp-route-id="@req.Id" class="btn btn-sm btn-outline-info">
                                            <i class="bx bx-info-circle"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">目前沒有待審核的申請</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
@if (Model.Requests != null)
{
    foreach (var req in Model.Requests)
    {
        @if (!req.IsCancelRequest)
        {
            @* 核准 Modal *@
            <div class="modal fade" id="approveModal-@req.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Approve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="bx bx-check-circle text-success"></i> 核准假單 #@req.Id</h5>
                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                            </div>
                            <div class="modal-body">
                                <p>確定要核准 <strong>@req.ApplicantName</strong> 的 <strong>@req.LeaveTypeName</strong> 假單嗎？</p>
                                <p class="text-muted">日期：@req.StartDate.ToString("yyyy-MM-dd") ~ @req.EndDate.ToString("yyyy-MM-dd")（@req.HoursUsed.ToString("0.#") 小時）</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                                <button type="submit" class="btn btn-success"><i class="bx bx-check"></i> 確認核准</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* 駁回 Modal *@
            <div class="modal fade" id="rejectModal-@req.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="bx bx-x-circle text-danger"></i> 駁回假單 #@req.Id</h5>
                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                            </div>
                            <div class="modal-body">
                                <p>確定要駁回 <strong>@req.ApplicantName</strong> 的 <strong>@req.LeaveTypeName</strong> 假單嗎？</p>
                                <div class="form-group">
                                    <label class="form-label">駁回原因 <span class="text-danger">*</span></label>
                                    <textarea name="rejectReason" class="form-control" rows="3" placeholder="請輸入駁回原因..." required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                                <button type="submit" class="btn btn-danger"><i class="bx bx-x"></i> 確認駁回</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* 核准取消 Modal *@
            <div class="modal fade" id="approveCancelModal-@req.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="ApproveCancelRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="bx bx-check-circle text-success"></i> 核准取消請假 #@req.Id</h5>
                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                            </div>
                            <div class="modal-body">
                                <p><strong>@req.ApplicantName</strong> 申請取消此 <strong>@req.LeaveTypeName</strong> 假單。</p>
                                <p class="text-muted">取消原因：@req.CancelReason</p>
                                <p class="text-muted">原狀態：@req.OriginalStatus</p>
                                <p>核准後將取消假單並退還假別餘額。</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">返回</button>
                                <button type="submit" class="btn btn-success"><i class="bx bx-check"></i> 確認核准取消</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* 駁回取消 Modal *@
            <div class="modal fade" id="rejectCancelModal-@req.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="RejectCancelRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="bx bx-x-circle text-danger"></i> 駁回取消請假 #@req.Id</h5>
                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                            </div>
                            <div class="modal-body">
                                <p><strong>@req.ApplicantName</strong> 申請取消此 <strong>@req.LeaveTypeName</strong> 假單。</p>
                                <p class="text-muted">取消原因：@req.CancelReason</p>
                                <p>駁回後假單將恢復為「@req.OriginalStatus」狀態。</p>
                                <div class="form-group">
                                    <label class="form-label">駁回原因 <span class="text-danger">*</span></label>
                                    <textarea name="rejectReason" class="form-control" rows="3" placeholder="請輸入駁回原因..." required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">返回</button>
                                <button type="submit" class="btn btn-danger"><i class="bx bx-x"></i> 確認駁回取消</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}
