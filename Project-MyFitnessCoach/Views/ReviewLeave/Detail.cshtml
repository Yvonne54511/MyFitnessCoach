@using Project_MyFitnessCoach.Models.DTOs
@model LeaveRequestDto

@{
    ViewData["Title"] = $"審核假單 #{Model.Id}";
    var isCancelRequest = Model.Status == "CancelPending";
    var isPending = Model.Status == "Pending";
    var canAction = isPending || isCancelRequest;
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="bx bx-detail"></i> @ViewData["Title"]</h2>
        </div>
    </div>

    <div class="row">
        <!-- 左側：申請單完整資訊 -->
        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="bx bx-file"></i> 申請單資訊
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th class="text-muted" style="width:120px;">申請人</th>
                                    <td>@Model.EmployeeName</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">部門</th>
                                    <td>@Model.DepartmentName</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">假別</th>
                                    <td>@Model.LeaveTypeName</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">請假日期</th>
                                    <td>@Model.StartDate.ToString("yyyy/MM/dd HH:mm") ~ @Model.EndDate.ToString("yyyy/MM/dd HH:mm")</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">時數</th>
                                    <td>@Model.HoursUsed.ToString("0.#") 小時（@Model.DaysUsed.ToString("0.#") 天）</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th class="text-muted" style="width:120px;">請假原因</th>
                                    <td>@(Model.Reason ?? "-")</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">代理人</th>
                                    <td>@(Model.DelegateName ?? "未指定")</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">狀態</th>
                                    <td>@await Html.PartialAsync("_LeaveStatusBadge", Model.Status)</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">申請時間</th>
                                    <td>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    @if (isCancelRequest)
                    {
                        <hr />
                        <div class="alert alert-warning mb-0">
                            <h6 class="font-weight-bold"><i class="bx bx-revision"></i> 取消請假請求</h6>
                            <table class="table table-borderless table-sm mb-0">
                                <tr>
                                    <th class="text-muted" style="width:120px;">原狀態</th>
                                    <td>@Model.OriginalStatus</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">取消原因</th>
                                    <td>@Model.CancelReason</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">申請取消時間</th>
                                    <td>@Model.CancelRequestedAt?.ToString("yyyy/MM/dd HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 右側：審核決定 -->
        <div class="col-lg-5">
            @if (canAction)
            {
                @if (isPending)
                {
                    @* 核准區塊 *@
                    <div class="card shadow-sm mb-4 border-left-success">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-success">
                                <i class="bx bx-check-circle"></i> 核准假單
                            </h6>
                        </div>
                        <div class="card-body">
                            <p>確認核准此假單後，員工的請假將生效。</p>
                            <form asp-action="Approve" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success btn-block">
                                    <i class="bx bx-check"></i> 核准
                                </button>
                            </form>
                        </div>
                    </div>

                    @* 駁回區塊 *@
                    <div class="card shadow-sm mb-4 border-left-danger">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-danger">
                                <i class="bx bx-x-circle"></i> 駁回假單
                            </h6>
                        </div>
                        <div class="card-body">
                            <form asp-action="Reject" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="form-group">
                                    <label class="form-label">駁回原因 <span class="text-danger">*</span></label>
                                    <textarea name="rejectReason" class="form-control" rows="3"
                                              placeholder="請輸入駁回原因..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger btn-block">
                                    <i class="bx bx-x"></i> 駁回
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else if (isCancelRequest)
                {
                    @* 核准取消區塊 *@
                    <div class="card shadow-sm mb-4 border-left-success">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-success">
                                <i class="bx bx-check-circle"></i> 核准取消
                            </h6>
                        </div>
                        <div class="card-body">
                            <p>核准後將取消此假單並退還假別餘額。</p>
                            <form asp-action="ApproveCancelRequest" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success btn-block">
                                    <i class="bx bx-check"></i> 核准取消
                                </button>
                            </form>
                        </div>
                    </div>

                    @* 駁回取消區塊 *@
                    <div class="card shadow-sm mb-4 border-left-danger">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-danger">
                                <i class="bx bx-x-circle"></i> 駁回取消請求
                            </h6>
                        </div>
                        <div class="card-body">
                            <p>駁回後假單將恢復為「@Model.OriginalStatus」狀態。</p>
                            <form asp-action="RejectCancelRequest" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="form-group">
                                    <label class="form-label">駁回原因 <span class="text-danger">*</span></label>
                                    <textarea name="rejectReason" class="form-control" rows="3"
                                              placeholder="請輸入駁回原因..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger btn-block">
                                    <i class="bx bx-x"></i> 駁回取消
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-body text-center text-muted">
                        <i class="bx bx-info-circle fa-2x mb-2"></i>
                        <p>此假單目前狀態為「@Model.Status」，無需審核。</p>
                    </div>
                </div>
            }

            <!-- 返回按鈕 -->
            <a asp-action="Pending" class="btn btn-secondary btn-block">
                <i class="bx bx-arrow-back"></i> 返回待審列表
            </a>
        </div>
    </div>
</div>
