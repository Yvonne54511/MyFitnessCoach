@{
    ViewData["Title"] = "主管審核管理";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-shield-check fs-2 text-primary me-2"></i>
        <h2 class="mb-0">請假審核與團隊管理</h2>
    </div>

    <div class="accordion" id="managerAccordion">

        <!-- 第一個：待我審核列表 (列表) -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingPending" 
                 data-bs-toggle="collapse" data-bs-target="#collapsePending" aria-expanded="false" 
                 style="cursor: pointer;">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark"><i class="bi bi-hourglass-split me-2 text-warning"></i>待我審核列表</h5>
                    <span class="badge bg-danger rounded-pill">5 筆待處理</span>
                </div>
            </div>
            <div id="collapsePending" class="collapse" aria-labelledby="headingPending" data-bs-parent="#managerAccordion">
                <div class="card-body bg-light-subtle">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light text-nowrap">
                                <tr>
                                    <th>申請同仁</th>
                                    <th>假別</th>
                                    <th>天數/時數</th>
                                    <th>起訖日期</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">林思敏 (營養師)</td>
                                    <td><span class="badge bg-info text-dark">特休</span></td>
                                    <td>2 天</td>
                                    <td>03/26 - 03/27</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">查看詳情</button>
                                        <button class="btn btn-sm btn-success ms-1"><i class="bi bi-check-lg"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">陳大為 (教練)</td>
                                    <td><span class="badge bg-warning text-dark">病假</span></td>
                                    <td>1 天</td>
                                    <td>03/20 - 03/20</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">查看詳情</button>
                                        <button class="btn btn-sm btn-success ms-1"><i class="bi bi-check-lg"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 第二個：審核詳情 -->
        <div class="card mb-3 shadow-sm border-0 border-start border-primary border-5">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingDetail" 
                 data-bs-toggle="collapse" data-bs-target="#collapseDetail" aria-expanded="false"
                 style="cursor: pointer;">
                <h5 class="mb-0 text-dark"><i class="bi bi-card-list me-2 text-primary"></i>審核詳情與決策</h5>
            </div>
            <div id="collapseDetail" class="collapse" aria-labelledby="headingDetail" data-bs-parent="#managerAccordion">
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <h6 class="text-muted mb-3"><i class="bi bi-person me-1"></i>申請人詳細資訊</h6>
                            <p><strong>姓名：</strong> 林思敏</p>
                            <p><strong>申請時間：</strong> 2026-03-18 14:30</p>
                            <p><strong>職務代理人：</strong> 王志宏 (已確認)</p>
                            <p><strong>剩餘年假：</strong> 5.5 天 (核准後剩 3.5 天)</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3"><i class="bi bi-chat-dots me-1"></i>主管核示意見</h6>
                            <textarea class="form-control mb-3" rows="3" placeholder="請輸入核示意見或駁回原因..."></textarea>
                            <div class="d-flex justify-content-end">
                                <button class="btn btn-danger me-2"><i class="bi bi-x-lg me-1"></i> 駁回申請</button>
                                <button class="btn btn-success px-4"><i class="bi bi-check-lg me-1"></i> 准予假</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 第三個：部門請假綜覽 (列表) -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingOverview" 
                 data-bs-toggle="collapse" data-bs-target="#collapseOverview" aria-expanded="false"
                 style="cursor: pointer;">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark"><i class="bi bi-calendar3 me-2 text-info"></i>部門請假綜覽</h5>
                    <small class="text-muted">顯示未來 7 天內之休假計畫</small>
                </div>
            </div>
            <div id="collapseOverview" class="collapse" aria-labelledby="headingOverview" data-bs-parent="#managerAccordion">
                <div class="card-body">
                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-lightbulb me-2 text-warning"></i>
                        提示：多名同仁於 03/26 同時休假，請留意人力調度。
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <span class="fw-bold">林思敏</span> 
                                <span class="badge bg-light text-dark border ms-2">03/26 - 03/27</span>
                            </div>
                            <span class="text-muted small">特休</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <span class="fw-bold">陳大為</span> 
                                <span class="badge bg-light text-dark border ms-2">03/20 - 03/20</span>
                            </div>
                            <span class="text-muted small">病假</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <span class="fw-bold">王志宏</span> 
                                <span class="badge bg-light text-dark border ms-2">03/28 - 03/28</span>
                            </div>
                            <span class="text-muted small">特休</span>
                        </li>
                    </ul>
                    <div class="mt-3 text-center">
                        <button class="btn btn-link btn-sm text-decoration-none">查看完整部門行事曆 <i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .cursor-pointer:hover { background-color: #f8f9fa !important; }
    .card-header[aria-expanded="true"] { border-bottom: 2px solid #0d6efd !important; }
    .bi { vertical-align: middle; }
</style>

<!-- 引入 Bootstrap Icons (若專案未包含) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
