@{
    ViewData["Title"] = "系統管理員 - 請假全域管理";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-gear-fill fs-2 text-dark me-2"></i>
        <h2 class="mb-0">請假系統全域管理</h2>
    </div>

    <div class="accordion" id="adminAccordion">

        <!-- 第一個：全部請假申請管理 (列表) -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingAllRequests" 
                 data-bs-toggle="collapse" data-bs-target="#collapseAllRequests" aria-expanded="false" 
                 style="cursor: pointer;">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark"><i class="bi bi-database-fill-gear me-2 text-primary"></i>全部請假申請管理</h5>
                    <div class="input-group input-group-sm w-25 d-none d-md-flex">
                        <input type="text" class="form-control" placeholder="搜尋同仁姓名...">
                        <button class="btn btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
            <div id="collapseAllRequests" class="collapse" aria-labelledby="headingAllRequests" data-bs-parent="#adminAccordion">
                <div class="card-body bg-light-subtle">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small">
                            <thead class="table-dark">
                                <tr>
                                    <th>申請單號</th>
                                    <th>同仁</th>
                                    <th>部門/職務</th>
                                    <th>假別</th>
                                    <th>日期</th>
                                    <th>主管審核</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>LR-2026-0001</td>
                                    <td class="fw-bold">林思敏</td>
                                    <td>營養部 / 營養師</td>
                                    <td><span class="badge bg-info text-dark">特休</span></td>
                                    <td>03/26 - 03/27</td>
                                    <td><span class="badge bg-success">已准假</span></td>
                                    <td><button class="btn btn-sm btn-outline-secondary">編輯</button></td>
                                </tr>
                                <tr>
                                    <td>LR-2026-0002</td>
                                    <td class="fw-bold">陳大為</td>
                                    <td>教練部 / 資深教練</td>
                                    <td><span class="badge bg-warning text-dark">病假</span></td>
                                    <td>03/20 - 03/20</td>
                                    <td><span class="badge bg-warning text-dark">審核中</span></td>
                                    <td><button class="btn btn-sm btn-outline-secondary">編輯</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 第二個：員工管理 -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingStaff" 
                 data-bs-toggle="collapse" data-bs-target="#collapseStaff" aria-expanded="false"
                 style="cursor: pointer;">
                <h5 class="mb-0 text-dark"><i class="bi bi-people-fill me-2 text-success"></i>員工管理與年假核發</h5>
            </div>
            <div id="collapseStaff" class="collapse" aria-labelledby="headingStaff" data-bs-parent="#adminAccordion">
                <div class="card-body">
                    <div class="row row-cols-1 row-cols-md-3 g-4">
                        <div class="col">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-circle fs-1 text-secondary mb-2"></i>
                                    <h6 class="card-title">林思敏</h6>
                                    <p class="card-text small text-muted">到職日：2024-01-01</p>
                                    <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded">
                                        <span class="small">目前剩餘年假</span>
                                        <span class="badge bg-primary">5.5 天</span>
                                    </div>
                                    <button class="btn btn-sm btn-link mt-2">修改額度</button>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-circle fs-1 text-secondary mb-2"></i>
                                    <h6 class="card-title">陳大為</h6>
                                    <p class="card-text small text-muted">到職日：2023-06-15</p>
                                    <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded">
                                        <span class="small">目前剩餘年假</span>
                                        <span class="badge bg-primary">10.0 天</span>
                                    </div>
                                    <button class="btn btn-sm btn-link mt-2">修改額度</button>
                                </div>
                            </div>
                        </div>
                        <div class="col d-flex align-items-center justify-content-center border-dashed">
                             <button class="btn btn-outline-success border-dashed"><i class="bi bi-plus-lg me-1"></i>批次核發年假</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 第三個：假別設定 (列表) -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingSettings" 
                 data-bs-toggle="collapse" data-bs-target="#collapseSettings" aria-expanded="false"
                 style="cursor: pointer;">
                <h5 class="mb-0 text-dark"><i class="bi bi-sliders2 me-2 text-info"></i>假別與規範設定</h5>
            </div>
            <div id="collapseSettings" class="collapse" aria-labelledby="headingSettings" data-bs-parent="#adminAccordion">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>假別名稱</th>
                                    <th>計算單位</th>
                                    <th>是否扣薪</th>
                                    <th>需附證明</th>
                                    <th>啟用狀態</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="fw-bold">特休</span></td>
                                    <td>天</td>
                                    <td>否</td>
                                    <td>否</td>
                                    <td><span class="text-success"><i class="bi bi-check-circle-fill"></i> 已啟用</span></td>
                                    <td><button class="btn btn-sm btn-outline-secondary">設定規則</button></td>
                                </tr>
                                <tr>
                                    <td><span class="fw-bold">病假</span></td>
                                    <td>小時</td>
                                    <td>是 (半薪)</td>
                                    <td>是 (超過 1 天)</td>
                                    <td><span class="text-success"><i class="bi bi-check-circle-fill"></i> 已啟用</span></td>
                                    <td><button class="btn btn-sm btn-outline-secondary">設定規則</button></td>
                                </tr>
                                <tr>
                                    <td><span class="fw-bold">生理假</span></td>
                                    <td>天</td>
                                    <td>是 (半薪)</td>
                                    <td>否</td>
                                    <td><span class="text-success"><i class="bi bi-check-circle-fill"></i> 已啟用</span></td>
                                    <td><button class="btn btn-sm btn-outline-secondary">設定規則</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .cursor-pointer:hover { background-color: #f8f9fa !important; }
    .card-header[aria-expanded="true"] { border-bottom: 2px solid #0d6efd !important; }
    .bi { vertical-align: middle; }
    .border-dashed { border: 2px dashed #dee2e6; border-radius: 8px; min-height: 200px; }
</style>

<!-- 引入 Bootstrap Icons (若專案未包含) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
