@{
    ViewData["Title"] = "員工請假管理";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-calendar-check fs-2 text-primary me-2"></i>
        <h2 class="mb-0">員工請假管理系統</h2>
    </div>

    <div class="accordion" id="leaveAccordion">

        <!-- 第一個：我的請假申請 (列表) -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingOne" 
                 data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" 
                 style="cursor: pointer;">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark"><i class="bi bi-list-ul me-2"></i>我的請假申請 (列表)</h5>
                    <span class="badge bg-primary rounded-pill">3 筆申請中</span>
                </div>
            </div>
            <div id="collapseOne" class="collapse" aria-labelledby="headingOne" data-bs-parent="#leaveAccordion">
                <div class="card-body bg-light-subtle">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>編號</th>
                                    <th>假別</th>
                                    <th>開始時間</th>
                                    <th>結束時間</th>
                                    <th>狀態</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#LR-001</td>
                                    <td><span class="badge bg-info text-dark">病假</span></td>
                                    <td>2026-03-20 09:00</td>
                                    <td>2026-03-20 18:00</td>
                                    <td><span class="badge bg-warning text-dark">審核中</span></td>
                                    <td><button class="btn btn-sm btn-outline-primary">詳情</button></td>
                                </tr>
                                <tr>
                                    <td>#LR-002</td>
                                    <td><span class="badge bg-secondary">事假</span></td>
                                    <td>2026-03-25 13:00</td>
                                    <td>2026-03-25 17:00</td>
                                    <td><span class="badge bg-success">已准假</span></td>
                                    <td><button class="btn btn-sm btn-outline-primary">詳情</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 第二個：新增請假申請 (表單) -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingTwo" 
                 data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false"
                 style="cursor: pointer;">
                <h5 class="mb-0 text-dark"><i class="bi bi-plus-circle-dotted me-2 text-success"></i>新增請假申請 (表單)</h5>
            </div>
            <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-bs-parent="#leaveAccordion">
                <div class="card-body">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">假別選擇</label>
                                <select class="form-select">
                                    <option selected>請選擇假別...</option>
                                    <option>特休</option>
                                    <option>病假 (需證明)</option>
                                    <option>事假</option>
                                    <option>公假</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">職務代理人</label>
                                <select class="form-select">
                                    <option selected>請選擇代理教練/同仁...</option>
                                    <option>林思敏</option>
                                    <option>陳大為</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">開始時間</label>
                                <input type="datetime-local" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">結束時間</label>
                                <input type="datetime-local" class="form-control">
                            </div>
                            <div class="col-12">
                                <label class="form-label">請假事由</label>
                                <textarea class="form-control" rows="3" placeholder="請輸入詳細事由..."></textarea>
                            </div>
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-secondary me-2">取消重填</button>
                                <button type="submit" class="btn btn-primary px-4">提交申請</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 第三個：申請詳情 -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingThree" 
                 data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false"
                 style="cursor: pointer;">
                <h5 class="mb-0 text-dark"><i class="bi bi-info-circle me-2 text-info"></i>申請詳情</h5>
            </div>
            <div id="collapseThree" class="collapse" aria-labelledby="headingThree" data-bs-parent="#leaveAccordion">
                <div class="card-body border-top">
                    <div class="alert alert-info d-flex align-items-center mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <div>請先從列表中選擇一筆申請以查看詳細資訊。</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 第四個：代理人設定 -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white py-3 cursor-pointer" id="headingFour" 
                 data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false"
                 style="cursor: pointer;">
                <h5 class="mb-0 text-dark"><i class="bi bi-person-badge me-2 text-warning"></i>代理人設定</h5>
            </div>
            <div id="collapseFour" class="collapse" aria-labelledby="headingFour" data-bs-parent="#leaveAccordion">
                <div class="card-body">
                    <p class="text-muted small mb-3">設定當您不在位時，預設優先請求的代理同仁及通知偏好。</p>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">自動接受代理請求</div>
                                <small class="text-muted">若同仁請求您為代理人，系統將自動同意</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch">
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-bold">常用代理人清單</div>
                                <small class="text-muted">目前設定：林思敏, 陳大為</small>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary">編輯清單</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .cursor-pointer:hover { background-color: #f8f9fa !important; }
    .card-header[aria-expanded="true"] { border-bottom: 2px solid #0d6efd !important; }
    .bi { vertical-align: middle; }
</style>

<!-- 引入 Bootstrap Icons (若專案未包含) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
