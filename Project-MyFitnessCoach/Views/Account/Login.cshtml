@model Project_MyFitnessCoach.Models.ViewModel.LoginViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入帳戶 | MyFitnessCoach</title>
    <link rel="stylesheet" href="~/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
</head>
<body class="account-page">
    <main class="account-shell">
        <section class="account-hero nutrition-hero">
            <div class="hero-overlay-card">
                <br />
                <br />
                <h3 class="hero-badge">My Fitness Coach</h3>
                <h1>守護未來，<br />與健康同行</h1>
                <p >落實初衷理念 傳遞專業溫度 創造無限可能</p>
                <br></br>
                
                <div class="hero-points">
                    <span><i class="fas fa-sun"></i> 成員管理</span>
                    <span><i class="fas fa-seedling"></i> 數據分析</span>
                    <span><i class="fas fa-shield-alt"></i> 安全防護</span>
                </div>
            </div>
        </section>

        <section class="account-card warm-card">
            <div class="card-header">
                <p class="eyebrow">My Fitness Coach</p>
                <h2>後台管理系統</h2>
                <p>請輸入管理帳號與密碼。</p>
            </div>

            @if (TempData["LoginMessage"] is string loginMessage)
            {
                <div class="status-banner success">@loginMessage</div>
            }

            <form asp-action="Login" method="post" class="account-form">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="Account"></label>
                    <div class="input-frame">
                        <i class="fas fa-user"></i>
                        <input asp-for="Account" placeholder="請輸入帳號" />
                    </div>
                    <span asp-validation-for="Account" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password"></label>
                    <div class="input-frame">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Password" placeholder="請輸入密碼" />
                        <button type="button" class="icon-button" id="togglePassword" aria-label="顯示或隱藏密碼">
                            <i class="fas fa-eye-slash" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="primary-button warm-button">登入帳戶</button>
            </form>

            <div class="card-links">
                <a asp-action="ForgetPassword">忘記密碼</a>
            </div>

            <hr style="border-color: #e0e0e0; margin: 1rem 0;" />
            <p style="text-align: center; color: #888; font-size: 0.85rem; margin-bottom: 0.5rem;">快速登入（測試用）</p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
                <button type="button" class="quick-login-btn" data-account="huqingwei12" data-password="@@A12345678"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem; border: 1px solid #ccc; border-radius: 6px; background: #f8f9fa; cursor: pointer; transition: background 0.2s;">
                    角色-營養師
                </button>
                <button type="button" class="quick-login-btn" data-account="gaoqingxing26" data-password="@@A12345678"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem; border: 1px solid #ccc; border-radius: 6px; background: #f8f9fa; cursor: pointer; transition: background 0.2s;">
                    角色-採購人員
                </button>
                <button type="button" class="quick-login-btn" data-account="zhaoyuqing36" data-password="@@A12345678"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem; border: 1px solid #ccc; border-radius: 6px; background: #f8f9fa; cursor: pointer; transition: background 0.2s;">
                    角色-行銷人員
                </button>
                <button type="button" class="quick-login-btn" data-account="chenzhiming1" data-password="@@A12345678"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem; border: 1px solid #ccc; border-radius: 6px; background: #f8f9fa; cursor: pointer; transition: background 0.2s;">
                    角色-採購主管
                </button>
                <button type="button" class="quick-login-btn" data-account="admin1" data-password="@@A12345678"
                        style="padding: 0.4rem 0.75rem; font-size: 0.8rem; border: 1px solid #ccc; border-radius: 6px; background: #f8f9fa; cursor: pointer; transition: background 0.2s;">
                    角色-系統管理員
                </button>
            </div>
        </section>
    </main>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('Password'); // 改回對應屬性生成的 ID
        const eyeIcon = document.getElementById('eyeIcon');

        if (togglePassword && passwordInput && eyeIcon) {
            togglePassword.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                eyeIcon.classList.toggle('fa-eye-slash', !isPassword);
                eyeIcon.classList.toggle('fa-eye', isPassword);
            });
        }

        // 快速登入按鈕
        document.querySelectorAll('.quick-login-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var account = this.getAttribute('data-account');
                var password = this.getAttribute('data-password');
                document.getElementById('Account').value = account;
                document.getElementById('Password').value = password;
                document.querySelector('.account-form').submit();
            });
        });
    </script>
</body>
</html>
