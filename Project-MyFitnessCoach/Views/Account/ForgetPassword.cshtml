@model Project_MyFitnessCoach.Models.ViewModel.ForgetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>忘記密碼 | MyFitnessCoach</title>
    <link rel="stylesheet" href="~/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
</head>
<body class="account-page">
    <main class="account-shell single-column">
        <section class="account-card wide">
            <div class="card-header">
                <p class="eyebrow">PASSWORD RESET</p>
                <h2>忘記密碼</h2>
                <p>輸入帳號綁定的電子信箱，我們會寄送重設密碼連結。</p>
            </div>

            @if (TempData["ResetPasswordError"] is string resetError)
            {
                <div class="status-banner error">@resetError</div>
            }

            @if (ViewBag.IsSent == true)
            {
                <div class="status-panel">
                    <div class="status-icon"><i class="fas fa-envelope-open-text"></i></div>
                    <div>
                        <h3>已發送驗證信</h3>
                        <p>請至 <strong>@ViewBag.Email</strong> 更改密碼。</p>
                        @if (ViewBag.EmailSent == false)
                        {
                            <p class="status-hint">目前尚未設定 SMTP，系統已將重設連結寫入伺服器 log 供開發測試。</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <form asp-action="ForgetPassword" method="post" class="account-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="field">
                        <label asp-for="Email"></label>
                        <div class="input-frame">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <button type="submit" class="primary-button">寄送驗證信</button>
                </form>
            }

            <div class="card-links">
                <a asp-action="Login">返回登入</a>
            </div>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
