@model Project_MyFitnessCoach.Models.ViewModel.ForgetPasswordViewModel
@{
    Layout = null;
    var isSent = ViewBag.IsSent == true;
    var resendUntil = isSent
        ? DateTimeOffset.UtcNow.AddMinutes(1).ToUnixTimeMilliseconds()
        : (long?)null;
    var isPost = Context.Request.Method == "POST";
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>忘記密碼 | MyFitnessCoach</title>
    <link rel="stylesheet" href="~/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
</head>
<body class="account-page">
    <main class="account-shell single-column">
        <section class="account-card wide">
            <div class="card-header">
                <p class="eyebrow">PASSWORD RESET</p>
                <h2>忘記密碼</h2>
                <p>請輸入您註冊時使用的電子信箱，我們將向您發送重設密碼的郵件。</p>
            </div>

            @if (TempData["ResetPasswordError"] is string resetError)
            {
                <div class="status-banner error">@resetError</div>
            }

            @if (isSent)
            {
                <div class="status-panel">
                    <div class="status-icon"><i class="fas fa-envelope-open-text"></i></div>
                    <div>
                        <h3>信件已發送</h3>
                        <p>請至 <strong>@ViewBag.Email</strong> 重設密碼。</p>
                    </div>
                </div>
            }

            <form asp-action="ForgetPassword" method="post" class="account-form" id="forgetPasswordForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="Email"></label>
                    <div class="input-frame">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" placeholder="name@example.com" autocomplete="off" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button type="submit"
                        class="primary-button deep-button"
                        id="sendResetButton"
                        data-is-sent="@(isSent ? "true" : "false")"
                        data-resend-until="@(resendUntil?.ToString() ?? string.Empty)"
                        data-is-post="@(isPost ? "true" : "false")">
                    透過電子郵件重設密碼<span class="countdown-text" id="sendResetCountdown"></span>
                </button>
            </form>

            <div class="card-links">
                <a asp-action="Login">返回登入</a>
            </div>
        </section>
    </main>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        const button = document.getElementById('sendResetButton');
        if (!button) return;

        const emailInput = document.getElementById('Email');
        const countdownEl = document.getElementById('sendResetCountdown');
        const form = document.getElementById('forgetPasswordForm');
        const RESEND_KEY = 'mfc-reset-resend-until';

        const safeNumber = (value) => {
            const parsed = Number(value);
            return Number.isFinite(parsed) ? parsed : null;
        };

        const readStored = () => {
            try {
                const stored = localStorage.getItem(RESEND_KEY);
                return stored ? safeNumber(stored) : null;
            } catch {
                return null;
            }
        };

        const writeStored = (value) => {
            try {
                localStorage.setItem(RESEND_KEY, String(value));
            } catch { }
        };

        const clearStored = () => {
            try {
                localStorage.removeItem(RESEND_KEY);
            } catch { }
        };

        const isPost = button.dataset.isPost === 'true';
        const isSent = button.dataset.isSent === 'true';
        let resendUntil = safeNumber(button.dataset.resendUntil);

        // 如果是全新的 GET 請求（非 POST 回傳），清空所有狀態
        if (!isPost) {
            clearStored();
            resendUntil = null;
            if (emailInput) emailInput.value = '';
        }

        // 如果是成功發送，則更新 localStorage 以便重新整理時能維持倒數
        if (isSent && resendUntil) {
            writeStored(resendUntil);
        } else if (!resendUntil) {
            // 如果當前沒有伺服器給的秒數，嘗試從暫存讀取
            resendUntil = readStored();
        }

        let timerId = null;

        const updateState = () => {
            const isCounting = resendUntil && resendUntil > Date.now();

            if (!isCounting) {
                resendUntil = null;
                clearStored();
                
                button.disabled = !emailInput.value.trim();
                
                if (countdownEl) countdownEl.textContent = '';
                if (timerId) {
                    clearInterval(timerId);
                    timerId = null;
                }
                return;
            }

            button.disabled = true;
            const remaining = resendUntil - Date.now();
            const seconds = Math.ceil(remaining / 1000);
            if (countdownEl) countdownEl.textContent = ` (${seconds}秒後可重新發送)`;
        };

        const startCountdown = () => {
            updateState();
            if (!timerId && resendUntil) {
                timerId = setInterval(updateState, 1000);
            }
        };

        if (emailInput) {
            emailInput.addEventListener('input', updateState);
        }

        if (resendUntil && resendUntil > Date.now()) {
            startCountdown();
        } else {
            updateState();
        }

        if (form) {
            form.addEventListener('submit', function (e) {
                if (typeof $ !== 'undefined' && $(form).length && !$(form).valid()) {
                    return;
                }
                setTimeout(() => { button.disabled = true; }, 0);
            });
        }
    })();
</script>
</body>
</html>
