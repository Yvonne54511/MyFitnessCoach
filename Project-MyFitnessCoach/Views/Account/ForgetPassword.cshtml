@model Project_MyFitnessCoach.Models.ViewModel.ForgetPasswordViewModel
@{
    Layout = null;
    var resendUntil = ViewBag.IsSent == true
        ? DateTimeOffset.UtcNow.AddMinutes(1).ToUnixTimeMilliseconds()
        : (long?)null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>忘記密碼 | MyFitnessCoach</title>
    <link rel="stylesheet" href="~/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
</head>
<body class="account-page">
    <main class="account-shell single-column">
        <section class="account-card wide">
            <div class="card-header">
                <p class="eyebrow">PASSWORD RESET</p>
                <h2>忘記密碼</h2>
                <p>請輸入您註冊時使用的電子信箱，我們將向您發送重設密碼的郵件。</p>
            </div>

            @if (TempData["ResetPasswordError"] is string resetError)
            {
                <div class="status-banner error">@resetError</div>
            }

            @if (ViewBag.IsSent == true)
            {
                <div class="status-panel">
                    <div class="status-icon"><i class="fas fa-envelope-open-text"></i></div>
                    <div>
                        <h3>已發送重設信</h3>
                        <p>請檢查 <strong>@ViewBag.Email</strong> 的信箱。</p>
                        @if (ViewBag.EmailSent == false)
                        {
                            <p class="status-hint">伺服器尚未設定 SMTP，系統已將重設連結寫入記錄，請聯絡管理員進行測試。</p>
                        }
                    </div>
                </div>
            }
                <form asp-action="ForgetPassword" method="post" class="account-form" id="forgetPasswordForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="field">
                        <label asp-for="Email"></label>
                        <div class="input-frame">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <button type="submit"
                        class="primary-button deep-button"
                        id="sendResetButton"
                        data-resend-until="@(resendUntil?.ToString() ?? string.Empty)">
                    發送重設信<span class="countdown-text" id="sendResetCountdown"></span>
                </button>
                </form>

            <div class="card-links">
                <a asp-action="Login">返回登入</a>
            </div>
        </section>
    </main>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        const button = document.getElementById('sendResetButton');
        if (!button) return;

        const countdownEl = document.getElementById('sendResetCountdown');
        const form = document.getElementById('forgetPasswordForm');
        const RESEND_KEY = 'mfc-reset-resend-until';
        const RESEND_MS = 60 * 1000;

        const safeNumber = (value) => {
            const parsed = Number(value);
            return Number.isFinite(parsed) ? parsed : null;
        };

        const readStored = () => {
            try {
                const stored = localStorage.getItem(RESEND_KEY);
                return stored ? safeNumber(stored) : null;
            } catch {
                return null;
            }
        };

        const writeStored = (value) => {
            try {
                localStorage.setItem(RESEND_KEY, String(value));
            } catch { }
        };

        const clearStored = () => {
            try {
                localStorage.removeItem(RESEND_KEY);
            } catch { }
        };

        let resendUntil = safeNumber(button.dataset.resendUntil);
        const storedUntil = readStored();
        if (storedUntil && (!resendUntil || storedUntil > resendUntil)) {
            resendUntil = storedUntil;
        }

        let timerId = null;

        const updateState = () => {
            if (!resendUntil) {
                button.disabled = false;
                if (countdownEl) countdownEl.textContent = '';
                return;
            }

            const remaining = resendUntil - Date.now();
            if (remaining <= 0) {
                resendUntil = null;
                clearStored();
                button.disabled = false;
                if (countdownEl) countdownEl.textContent = '';
                if (timerId) {
                    clearInterval(timerId);
                    timerId = null;
                }
                return;
            }

            button.disabled = true;
            const seconds = Math.ceil(remaining / 1000);
            if (countdownEl) countdownEl.textContent = ` (${seconds}s)`;
        };

        const startCountdown = () => {
            updateState();
            if (!timerId) {
                timerId = setInterval(updateState, 1000);
            }
        };

        if (resendUntil && resendUntil > Date.now()) {
            writeStored(resendUntil);
            startCountdown();
        } else {
            clearStored();
            updateState();
        }

        if (form) {
            form.addEventListener('submit', function () {
                if (form.checkValidity && !form.checkValidity()) return;
                const target = Date.now() + RESEND_MS;
                resendUntil = target;
                writeStored(target);
                startCountdown();
            });
        }
    })();
</script>
</body>
</html>
