@model Project_MyFitnessCoach.Models.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>重設密碼 | MyFitnessCoach</title>
    <link rel="stylesheet" href="~/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
</head>
<body class="account-page">
    <main class="account-shell single-column">
        <section class="account-card wide">
            <div class="card-header">
                <p class="eyebrow">RESET PASSWORD</p>
                <h2>ResetPassword</h2>
                <p>請輸入新的登入密碼，完成後可直接回登入頁登入。</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="account-form">
                @Html.AntiForgeryToken()
                <input asp-for="Code" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label asp-for="Password"></label>
                    <div class="input-frame">
                        <i class="fas fa-key"></i>
                        <input asp-for="Password" placeholder="請輸入 6-12 碼新密碼" />
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword"></label>
                    <div class="input-frame">
                        <i class="fas fa-check-circle"></i>
                        <input asp-for="ConfirmPassword" placeholder="請再次輸入新密碼" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="primary-button">更新密碼</button>
            </form>

            <div class="card-links">
                <a asp-action="Login">返回登入</a>
            </div>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
