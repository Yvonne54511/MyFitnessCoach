@model Project_MyFitnessCoach.Models.ViewModel.ChangePasswordViewModel
@{
    ViewData["Title"] = "修改密碼";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">帳密修改</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">修改您的登入密碼</h6>
                </div>
                <div class="card-body">
                    @if (TempData["ChangePasswordSuccess"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle mr-2"></i> @TempData["ChangePasswordSuccess"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <p class="text-center">您的密碼已更新成功。</p>
                        <div class="text-center mt-4">
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">回到儀表板</a>
                        </div>
                    }
                    else
                    {
                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="form-group">
                                <label asp-for="OldPassword" class="font-weight-bold">目前密碼</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    </div>
                                    <input asp-for="OldPassword" class="form-control" placeholder="請輸入目前使用的密碼" />
                                </div>
                                <span asp-validation-for="OldPassword" class="text-danger small"></span>
                            </div>

                            <hr />

                            <div class="form-group">
                                <label asp-for="NewPassword" class="font-weight-bold">新密碼</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-key"></i></span>
                                    </div>
                                    <input asp-for="NewPassword" class="form-control" placeholder="請輸入 6-12 碼新密碼" />
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="ConfirmPassword" class="font-weight-bold">確認新密碼</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                                    </div>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="請再次輸入新密碼" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary btn-block">儲存修改</button>
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-link btn-block text-muted">取消</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
