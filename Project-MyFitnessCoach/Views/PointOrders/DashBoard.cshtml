@using Project_MyFitnessCoach.Models.ViewModels
@model PointOrderDashboardViewModel
@{
    ViewData["Title"] = "點數儲值數據概覽";
}

<div class="container-fluid">
    <!-- 頂部標題 -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">點數儲值數據概覽</h1>
        <div class="d-flex align-items-center">
            <a asp-action="Index" class="btn btn-sm btn-primary shadow-sm mr-3">
                <i class="fas fa-list fa-sm text-white-50 mr-1"></i> 儲值訂單管理
            </a>
            <div class="text-muted small">最後更新時間：@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>
        </div>
    </div>

    <!-- 頂部數據列 (KPI 指標 - 3 欄位) -->
    <div class="row">
        <!-- 今日營收 -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">今日營收</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800">NT$ @Model.TodayRevenue.ToString("N0")</div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                @if (Model.RevenueTrend >= 0)
                                {
                                    <span class="text-success mr-2"><i class="fa fa-arrow-up"></i> @Model.RevenueTrend%</span>
                                }
                                else
                                {
                                    <span class="text-danger mr-2"><i class="fa fa-arrow-down"></i> @Math.Abs(Model.RevenueTrend)%</span>
                                }
                                <span>較昨日同期</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 本月儲值總計 -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">本月儲值總計</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800">NT$ @Model.MonthTotal.ToString("N0")</div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                @if (Model.MonthComparison >= 0)
                                {
                                    <span class="text-success mr-2"><i class="fa fa-arrow-up"></i> @Model.MonthComparison%</span>
                                }
                                else
                                {
                                    <span class="text-danger mr-2"><i class="fa fa-arrow-down"></i> @Math.Abs(Model.MonthComparison)%</span>
                                }
                                <span>較上月同期</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 總流通點數 (負債) -->
        <div class="col-xl-4 col-md-12 mb-4">
            <div class="card border-left-secondary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">總流通點數 (系統負債)</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800">@Model.TotalCirculatingPoints.ToString("N0") P</div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <span>目前系統內所有會員持有之剩餘點數</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-coins fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 中間圖表列：儲值趨勢 (堆疊面積圖) -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">儲值趨勢 (近 30 日)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="rechargeTrendChart" style="height: 300px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部圖表列：熱門儲值方案 (橫向長條圖) -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">熱門儲值方案排行榜</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="popularPlansChart" style="height: 400px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/chart.js/Chart.min.js"></script>
    <script>
        // 設定圖表字體
        Chart.defaults.global.defaultFontFamily = 'Nunito', '-apple-system,system-ui,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif';
        Chart.defaults.global.defaultFontColor = '#858796';

        // 1. 儲值趨勢 - 堆疊面積圖 (Stacked Area Chart)
        var ctxTrend = document.getElementById("rechargeTrendChart");
        var rechargeTrendChart = new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TrendLabels)),
                datasets: [{
                    label: "實際支付金額",
                    lineTension: 0.3,
                    backgroundColor: "rgba(78, 115, 223, 0.5)",
                    borderColor: "rgba(78, 115, 223, 1)",
                    pointRadius: 3,
                    pointBackgroundColor: "rgba(78, 115, 223, 1)",
                    pointBorderColor: "rgba(78, 115, 223, 1)",
                    pointHoverRadius: 3,
                    pointHoverBackgroundColor: "rgba(78, 115, 223, 1)",
                    pointHoverBorderColor: "rgba(78, 115, 223, 1)",
                    pointHitRadius: 10,
                    pointBorderWidth: 2,
                    data: @Html.Raw(Json.Serialize(Model.ActualPaymentData)),
                }, {
                    label: "系統贈送點數",
                    lineTension: 0.3,
                    backgroundColor: "rgba(28, 200, 138, 0.5)",
                    borderColor: "rgba(28, 200, 138, 1)",
                    pointRadius: 3,
                    pointBackgroundColor: "rgba(28, 200, 138, 1)",
                    pointBorderColor: "rgba(28, 200, 138, 1)",
                    pointHoverRadius: 3,
                    pointHoverBackgroundColor: "rgba(28, 200, 138, 1)",
                    pointHoverBorderColor: "rgba(28, 200, 138, 1)",
                    pointHitRadius: 10,
                    pointBorderWidth: 2,
                    data: @Html.Raw(Json.Serialize(Model.BonusPointsData)),
                }],
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    xAxes: [{
                        time: {
                            unit: 'date'
                        },
                        gridLines: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            maxTicksLimit: 7
                        }
                    }],
                    yAxes: [{
                        stacked: true,
                        ticks: {
                            maxTicksLimit: 5,
                            padding: 10,
                            callback: function(value, index, values) {
                                return 'NT$ ' + value.toLocaleString();
                            }
                        },
                        gridLines: {
                            color: "rgb(234, 236, 244)",
                            zeroLineColor: "rgb(234, 236, 244)",
                            drawBorder: false,
                            borderDash: [2],
                            zeroLineBorderDash: [2]
                        }
                    }],
                },
                legend: {
                    display: true,
                    position: 'top'
                },
                tooltips: {
                    backgroundColor: "rgb(255,255,255)",
                    bodyFontColor: "#858796",
                    titleMarginBottom: 10,
                    titleFontColor: '#6e707e',
                    titleFontSize: 14,
                    borderColor: '#dddfeb',
                    borderWidth: 1,
                    xPadding: 15,
                    yPadding: 15,
                    displayColors: false,
                    intersect: false,
                    mode: 'index',
                    caretPadding: 10,
                    callbacks: {
                        label: function(tooltipItem, chart) {
                            var datasetLabel = chart.datasets[tooltipItem.datasetIndex].label || '';
                            return datasetLabel + ': NT$ ' + tooltipItem.yLabel.toLocaleString();
                        }
                    }
                }
            }
        });

        // 2. 熱門儲值方案 - 橫向長條圖 (Horizontal Bar Chart)
        var ctxPlans = document.getElementById("popularPlansChart");
        var popularPlansChart = new Chart(ctxPlans, {
            type: 'horizontalBar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.PlanNames)),
                datasets: [{
                    label: "銷售次數",
                    backgroundColor: "#4e73df",
                    hoverBackgroundColor: "#2e59d9",
                    borderColor: "#4e73df",
                    data: @Html.Raw(Json.Serialize(Model.PlanSales)),
                }],
            },
            options: {
                maintainAspectRatio: false,
                layout: {
                    padding: {
                        left: 10,
                        right: 25,
                        top: 25,
                        bottom: 0
                    }
                },
                scales: {
                    xAxes: [{
                        ticks: {
                            beginAtZero: true,
                            maxTicksLimit: 10,
                            padding: 10,
                        },
                        gridLines: {
                            color: "rgb(234, 236, 244)",
                            zeroLineColor: "rgb(234, 236, 244)",
                            drawBorder: false,
                            borderDash: [2],
                            zeroLineBorderDash: [2]
                        }
                    }],
                    yAxes: [{
                        gridLines: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            maxTicksLimit: 10
                        }
                    }],
                },
                legend: {
                    display: false
                },
                tooltips: {
                    titleMarginBottom: 10,
                    titleFontColor: '#6e707e',
                    titleFontSize: 14,
                    backgroundColor: "rgb(255,255,255)",
                    bodyFontColor: "#858796",
                    borderColor: '#dddfeb',
                    borderWidth: 1,
                    xPadding: 15,
                    yPadding: 15,
                    displayColors: false,
                    caretPadding: 10,
                    callbacks: {
                        label: function(tooltipItem, chart) {
                            var datasetLabel = chart.datasets[tooltipItem.datasetIndex].label || '';
                            return datasetLabel + ': ' + tooltipItem.xLabel.toLocaleString() + ' 次';
                        }
                    }
                },
            }
        });
    </script>
}
