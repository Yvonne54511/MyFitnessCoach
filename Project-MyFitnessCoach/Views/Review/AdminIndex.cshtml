@model IEnumerable<Project_MyFitnessCoach.Models.Dtos.ReviewDto>
@{
    ViewData["Title"] = "所有評論管理 (管理員)";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>學員</th>
                            <th>營養師</th>
                            <th>評分</th>
                            <th>內容</th>
                            <th>詳細狀態</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @item.MemberName 
                                    @if (!item.IsUserActive) { <span class="badge badge-danger">已停權</span> }
                                </td>
                                <td>@item.InstructorName</td>
                                <td class="text-warning">
                                    @for (int i = 0; i < item.Rating; i++) { <i class="fas fa-star"></i> }
                                </td>
                                <td>@Html.Raw(item.Comment)</td>
                                <td>
                                    <button class="btn btn-info btn-sm detail-btn" 
                                            data-id="@item.Id"
                                            data-member="@item.MemberName"
                                            data-instructor="@item.InstructorName"
                                            data-rating="@item.Rating"
                                            data-comment="@item.Comment"
                                            data-report="@item.ReportMessage"
                                            data-member-id="@item.MemberId"
                                            data-active="@item.IsUserActive.ToString().ToLower()"
                                            data-toggle="modal" 
                                            data-target="#detailModal">
                                        詳細內容
                                        @if (!string.IsNullOrEmpty(item.ReportMessage))
                                        {
                                            <span class="badge badge-warning ml-1">有檢舉</span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Review Detail Modal (Bootstrap 4) -->
<div class="modal fade" id="detailModal" tabindex="-1" role="dialog" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailModalLabel">評論詳細資訊</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>學員：</strong> <span id="spanMember"></span></p>
                        <p><strong>營養師：</strong> <span id="spanInstructor"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>評分：</strong> <span id="spanRating" class="text-warning"></span></p>
                    </div>
                </div>
                <hr />
                <h6>評論內容：</h6>
                <p class="border p-3 bg-light rounded" id="pComment"></p>
                
                <div id="divReport" class="mt-3 d-none">
                    <h6 class="text-danger"><i class="fas fa-exclamation-triangle"></i> 營養師檢舉原因：</h6>
                    <p class="border p-3 bg-light border-danger text-danger rounded" id="pReportMessage"></p>
                </div>
            </div>
            <div class="modal-footer">
                <form asp-action="DeleteReview" method="post" id="formDelete" class="m-0">
                    <input type="hidden" name="id" id="inputReviewId" />
                    <button type="submit" class="btn btn-danger" onclick="return confirm('確定永久刪除此留言？');">Ban 留言</button>
                </form>
                
                <form asp-action="SuspendMember" method="post" id="formSuspend" class="m-0">
                    <input type="hidden" name="memberId" id="inputMemberId" />
                    <button type="submit" id="btnSuspend" class="btn btn-dark" onclick="return confirm('確定停權此學員？');">停權學員</button>
                </form>
                
                <button type="button" class="btn btn-secondary" data-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.detail-btn').on('click', function() {
                var btn = $(this);
                var reportMsg = btn.attr('data-report'); // 使用 attr() 較穩定
                
                $('#spanMember').text(btn.data('member'));
                $('#spanInstructor').text(btn.data('instructor'));
                $('#pComment').html(btn.attr('data-comment')); // 修改為 .html()
                $('#inputReviewId').val(btn.data('id'));
                $('#inputMemberId').val(btn.data('member-id'));

                // 評分星星
                var stars = '';
                var rating = parseInt(btn.data('rating'));
                for(var i=0; i<rating; i++) stars += '★';
                $('#spanRating').text(stars);

                // 檢舉內容：僅在真正有內容時移除 d-none
                if (reportMsg && reportMsg.trim().length > 0) {
                    $('#pReportMessage').text(reportMsg);
                    $('#divReport').removeClass('d-none');
                } else {
                    $('#divReport').addClass('d-none');
                }

                // 停權按鈕顯示控制
                if(btn.attr('data-active') === "true") {
                    $('#formSuspend').show();
                } else {
                    $('#formSuspend').hide();
                }
            });

            // 敏感字詞點擊切換邏輯
            $(document).on('click', '.sensitive-toggle', function() {
                var $this = $(this);
                var original = $this.data('original');
                var masked = $this.data('masked');
                
                if ($this.text() === masked) {
                    $this.text(original).removeClass('text-danger').addClass('text-success');
                } else {
                    $this.text(masked).removeClass('text-success').addClass('text-danger');
                }
            });
        });
    </script>
}
