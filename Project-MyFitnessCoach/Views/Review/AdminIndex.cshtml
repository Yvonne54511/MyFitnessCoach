@model IEnumerable<Project_MyFitnessCoach.Models.Dtos.ReviewDto>
@{
    ViewData["Title"] = "所有評論管理 (管理員)";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>學員</th>
                            <th>營養師</th>
                            <th>評分</th>
                            <th>內容</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @item.MemberName 
                                    @if (!item.IsUserActive) { <span class="badge badge-danger">已停權</span> }
                                </td>
                                <td>@item.InstructorName</td>
                                <td class="text-warning">
                                    @for (int i = 0; i < item.Rating; i++) { <i class="fas fa-star"></i> }
                                </td>
                                <td>@item.Comment</td>
                                <td>
                                    <form asp-action="DeleteReview" method="post" class="d-inline" onsubmit="return confirm('確定刪除？');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-danger btn-sm">Ban</button>
                                    </form>
                                    @if (item.IsUserActive)
                                    {
                                        <form asp-action="SuspendMember" method="post" class="d-inline" onsubmit="return confirm('確定停權？');">
                                            <input type="hidden" name="memberId" value="@item.MemberId" />
                                            <button class="btn btn-dark btn-sm">停權學員</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
