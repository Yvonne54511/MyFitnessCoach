@model IEnumerable<Project_MyFitnessCoach.Models.DTOs.ReviewDto>
@{
    ViewData["Title"] = "我的評論與舉報";
}

@section Styles {
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <style>
        #instructorReviewTable thead th {
            color: white !important;
            background-color: #343a40 !important;
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary"><i class='bx bx-comment-detail'></i> @ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center" id="instructorReviewTable" width="100%" cellspacing="0">
                    <thead class="table-dark text-white">
                        <tr>
                            <th>時間</th>
                            <th>學員</th>
                            <th>評分</th>
                            <th>評論內容</th>
                            <th class="no-sort">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-order="@item.CreatedAt.Ticks">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.MemberName</td>
                                <td class="text-warning" data-order="@item.Rating">
                                    @for (int i = 0; i < item.Rating; i++) { <i class='bx bxs-star'></i> }
                                    @for (int i = item.Rating; i < 5; i++) { <i class='bx bx-star text-muted'></i> }
                                </td>
                                <td class="text-start">@Html.Raw(item.Comment)</td>
                                <td>
                                    <button class="btn btn-warning btn-sm report-btn" 
                                            data-review-id="@item.Id" 
                                            data-member-name="@item.MemberName"
                                            data-toggle="modal" 
                                            data-target="#reportModal">
                                        <i class='bx bx-error-circle'></i> 舉報
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Report Modal (Bootstrap 4 Style) -->
<div class="modal fade" id="reportModal" tabindex="-1" role="dialog" aria-labelledby="reportModalLabel" aria-hidden="true">
    <!-- ... unchanged content ... -->
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="ReportReview" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalReviewId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="reportModalLabel"><i class='bx bx-error'></i> 舉報不實評論</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>您正在舉報學員 <strong id="modalMemberName"></strong> 的評論。</p>
                    <div class="form-group">
                        <label for="reportReason">請輸入舉報原因：</label>
                        <textarea class="form-control" name="reason" id="reportReason" rows="4" required placeholder="請詳細描述此評論不實之處..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class='bx bx-x'></i> 取消
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class='bx bx-send'></i> 送出舉報
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#instructorReviewTable').DataTable({
                "order": [[ 0, "desc" ]],
                "columnDefs": [
                    { "orderable": false, "targets": 4 }
                ],
                "language": {
                    "processing": "處理中...",
                    "loadingRecords": "載入中...",
                    "lengthMenu": "顯示 _MENU_ 項結果",
                    "zeroRecords": "沒有符合的結果",
                    "info": "顯示第 _START_ 至 _END_ 項結果，共 _TOTAL_ 項",
                    "infoEmpty": "顯示第 0 至 0 項結果，共 0 項",
                    "infoFiltered": "(從 _MAX_ 項結果中過濾)",
                    "search": "搜尋:",
                    "paginate": {
                        "first": "第一頁",
                        "previous": "上一頁",
                        "next": "下一頁",
                        "last": "最後一頁"
                    }
                }
            });

            $('.report-btn').on('click', function() {
                var reviewId = $(this).data('review-id');
                var memberName = $(this).data('member-name');
                $('#modalReviewId').val(reviewId);
                $('#modalMemberName').text(memberName);
            });

            $(document).on('click', '.sensitive-toggle', function() {
                var $this = $(this);
                var original = $this.data('original');
                var masked = $this.data('masked');
                if ($this.text() === masked) {
                    $this.text(original).removeClass('text-danger').addClass('text-success');
                } else {
                    $this.text(masked).removeClass('text-success').addClass('text-danger');
                }
            });
        });
    </script>
}
