@model IEnumerable<Project_MyFitnessCoach.Models.Dtos.ReviewDto>
@{
    ViewData["Title"] = "我的評論與舉報";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>學員</th>
                            <th>評分</th>
                            <th>評論內容</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.MemberName</td>
                                <td class="text-warning">
                                    @for (int i = 0; i < item.Rating; i++) { <i class="fas fa-star"></i> }
                                </td>
                                <td>@item.Comment</td>
                                <td>
                                    @* Bootstrap 4 使用 data-toggle 而非 data-bs-toggle *@
                                    <button class="btn btn-warning btn-sm report-btn" 
                                            data-review-id="@item.Id" 
                                            data-member-name="@item.MemberName"
                                            data-toggle="modal" 
                                            data-target="#reportModal">
                                        舉報
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Report Modal (Bootstrap 4 Style) -->
<div class="modal fade" id="reportModal" tabindex="-1" role="dialog" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="ReportReview" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalReviewId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="reportModalLabel">舉報不實評論</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>您正在舉報學員 <strong id="modalMemberName"></strong> 的評論。</p>
                    <div class="form-group">
                        <label for="reportReason">請輸入舉報原因：</label>
                        <textarea class="form-control" name="reason" id="reportReason" rows="4" required placeholder="請詳細描述此評論不實之處..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-warning">送出舉報</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 點擊舉報按鈕時，將資料帶入 Modal
            $('.report-btn').on('click', function() {
                var reviewId = $(this).data('review-id');
                var memberName = $(this).data('member-name');
                
                $('#modalReviewId').val(reviewId);
                $('#modalMemberName').text(memberName);
            });
        });
    </script>
}
