@using Microsoft.EntityFrameworkCore
@using Project_MyFitnessCoach.Models.EfModels
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="MyFitnessCoach Admin Dashboard">
    <meta name="author" content="MyFitnessCoach">
    <title>@(ViewData["Title"] ?? "MyFitnessCoach 後台")</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/layout-warm.css" rel="stylesheet">
    <style>
        /* 當 sidebar 縮小時隱藏登入資訊卡片 */
        .sidebar.toggled .sidebar-login-info {
            display: none !important;
        }
    </style>
    @RenderSection("styles", required: false)
    <script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-controller="Dashboard" asp-action="Index">
                <div class="sidebar-brand-text mx-3">@(ViewBag.Title ?? "後台管理")</div>
            </a>
            <hr class="sidebar-divider">
            <div class="sidebar-heading">數據統計</div>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseDashboard" aria-expanded="true" aria-controls="collapseDashboard">
                    <i class="bx bx-home-circle"></i>
                    <span>Dashboard</span>
                </a>
                <div id="collapseDashboard" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-controller="Dashboard" asp-action="Index">後台概覽</a>
                        <a class="collapse-item" asp-controller="Dashboard" asp-action="Rating">評論統計</a>
                    </div>
                </div>
            </li>
            

            @{
                
                var userFunctions = User.FindAll("Function").Select(f => f.Value).ToList();
                bool hasEmployeeId = User.FindFirst("EmployeeId") != null;

                //人員管理
                bool canEditPassword = userFunctions.Contains("edit_Password");
                bool canEditInstructorDetails = userFunctions.Contains("edit_InstructorDetails");

                //班表管理
                bool canEditInstructorShifts = userFunctions.Contains("edit_InstructorShifts");
                bool canViewInstructorShifts = userFunctions.Contains("view_InstructorShifts");

                //帳號管理
                bool canEditUserAccounts = userFunctions.Contains("edit_UserAccounts");
                bool canEditRoleFunctions = userFunctions.Contains("edit_RoleFunctions");
                // bool canEditUserRoles = userFunctions.Contains("edit_UserRoles");
                // bool isInstructor = User.HasClaim(c => c.Type == "InstructorId");

                // 商品管理
                bool canEditProductCategories = userFunctions.Contains("edit_ProductCategories");
                bool canEditProductsItems = userFunctions.Contains("edit_ProductItems");
                bool canEditProductOrders = userFunctions.Contains("edit_ProductOrders");

                //方案管理
                bool canEditPlans = userFunctions.Contains("edit_Plans");
                bool canEditPlanOrders = userFunctions.Contains("edit_PlanOrders");

                //客戶管理
                bool canViewPointRecords = userFunctions.Contains("view_PointRecords");
                bool canViewClientFoodRecords = userFunctions.Contains("view_ClientFoodRecords");
                bool canViewClientBodyData = userFunctions.Contains("view_ClientBodyData");

                // 評論與其他權限
                bool canEditCommentsAdmin = userFunctions.Contains("edit_Comments_admin");
                bool canEditCommentsInstructor = userFunctions.Contains("edit_Comments_instructor");
                bool canViewKeyWords = userFunctions.Contains("view_KeyWords");
				bool canEditKeyWords = userFunctions.Contains("edit_KeyWords");
                bool canViewSalary = userFunctions.Contains("view_Salary");
                bool canViewSalary2 = userFunctions.Contains("view_Salary2");
                bool canEditViolations = userFunctions.Contains("edit_MemberViolations");

                // 請假系統權限
                bool canViewLeaveRequests = userFunctions.Contains("view_LeaveRequests");
                bool canEditLeaveRequests = userFunctions.Contains("edit_LeaveRequests");
                bool canEditWorkDelegate = userFunctions.Contains("edit_WorkDelegate");
                bool canReviewLeaveRequests = userFunctions.Contains("review_LeaveRequests");
                bool canViewDeptLeave = userFunctions.Contains("view_DeptLeave");
                bool canAdminLeaveRequests = userFunctions.Contains("admin_LeaveRequests");
                bool canAdminEmployees = userFunctions.Contains("admin_Employees");
                bool canAdminHolidays = userFunctions.Contains("admin_Holidays");
                bool canAdminLeaveBalances = userFunctions.Contains("admin_LeaveBalances");

                // 步驟 5.2: 查詢是否有代審授權
                bool hasDelegation = false;
                if (hasEmployeeId)
                {
                    var dbContext = Context.RequestServices.GetRequiredService<MyFitnessCoachDbContext>();
                    var empIdValue = int.Parse(User.FindFirst("EmployeeId").Value);
                    var now = DateTime.Now;
                    hasDelegation = await dbContext.LeaveApprovalDelegations
                        .AnyAsync(d => d.DelegateEmployeeId == empIdValue
                            && d.IsActive
                            && d.StartDate <= now
                            && d.EndDate >= now);
                }
                }

            

            @if (canEditPassword || canEditInstructorDetails)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">個人中心</div>
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseUser" aria-expanded="true" aria-controls="collapseUser">
                        <i class="bx bx-user"></i>
                        <span>個人資料維護</span>
                    </a>
                    <div id="collapseUser" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            @if (canEditPassword)
                            {
                                <a class="collapse-item" asp-controller="Account" asp-action="ChangePassword">帳密修改</a>
                            }
                            @if (canEditInstructorDetails)
                            {
                                <a class="collapse-item" asp-controller="Account" asp-action="InstructorDetails">資料維護-營養師</a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canViewLeaveRequests || canEditLeaveRequests || canEditWorkDelegate
                        || canReviewLeaveRequests || canViewDeptLeave
                        || canAdminLeaveRequests || canAdminEmployees
                        || canAdminHolidays || canAdminLeaveBalances)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">請假系統</div>

                @* 員工請假功能（需有 Employee 身份）*@
                @if (hasEmployeeId && (canViewLeaveRequests || canEditLeaveRequests || canEditWorkDelegate))
                {
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse"
                           data-target="#collapseLeave" aria-expanded="false" aria-controls="collapseLeave">
                            <i class="bx bx-calendar-x"></i>
                            <span>我的請假</span>
                        </a>
                        <div id="collapseLeave" class="collapse" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                @if (canViewLeaveRequests)
                                {
                                    <a class="collapse-item" asp-controller="ApplyLeave" asp-action="List">我的請假申請</a>
                                }
                                @if (canEditLeaveRequests)
                                {
                                    <a class="collapse-item" asp-controller="ApplyLeave" asp-action="Add">新增請假申請</a>
                                }
                                @if (canEditWorkDelegate)
                                {
                                    <a class="collapse-item" asp-controller="ApplyLeave" asp-action="WorkDelegate">代理人設定</a>
                                }
                            </div>
                        </div>
                    </li>
                }

                @* 主管審核功能（需有 Employee 身份）— 步驟 5.2: 含代審授權 *@
                @if (hasEmployeeId && (canReviewLeaveRequests || canViewDeptLeave || hasDelegation))
                {
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse"
                           data-target="#collapseReviewLeave" aria-expanded="false" aria-controls="collapseReviewLeave">
                            <i class="bx bx-check-double"></i>
                            <span>主管審核</span>
                        </a>
                        <div id="collapseReviewLeave" class="collapse" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                @if (canReviewLeaveRequests || hasDelegation)
                                {
                                    <a class="collapse-item" asp-controller="ReviewLeave" asp-action="Pending">待我審核</a>
                                }
                                @if (canViewDeptLeave)
                                {
                                    <a class="collapse-item" asp-controller="ReviewLeave" asp-action="List">部門請假總覽</a>
                                }
                            </div>
                        </div>
                    </li>
                }

                @* 管理員功能 *@
                @if (canAdminLeaveRequests || canAdminEmployees || canAdminHolidays || canAdminLeaveBalances)
                {
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse"
                           data-target="#collapseAdminLeave" aria-expanded="false" aria-controls="collapseAdminLeave">
                            <i class="bx bx-cog"></i>
                            <span>請假管理(Admin)</span>
                        </a>
                        <div id="collapseAdminLeave" class="collapse" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                @if (canAdminLeaveRequests)
                                {
                                    <a class="collapse-item" asp-controller="AdminLeave" asp-action="List">假單管理</a>
                                }
                                @if (canAdminEmployees)
                                {
                                    <a class="collapse-item" asp-controller="AdminLeave" asp-action="EmployeeList">員工代理人管理</a>
                                }
                                @if (canAdminHolidays)
                                {
                                    <a class="collapse-item" asp-controller="AdminLeave" asp-action="HolidayList">國定假日管理</a>
                                }
                                @if (canAdminLeaveBalances)
                                {
                                    <a class="collapse-item" asp-controller="AdminLeave" asp-action="BalanceList">假別額度管理</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            }

           

            @if (canEditUserAccounts || canEditRoleFunctions || canEditViolations)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">帳號管理</div>
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseStaff" aria-expanded="true" aria-controls="collapseStaff">
                        <i class="fa-solid fa-people-group"></i>
                        <span>帳號與權限管理</span>
                    </a>
                    <div id="collapseStaff" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            @if (canEditUserAccounts)
                            {
                                <a class="collapse-item" asp-controller="Staff" asp-action="Index">使用者帳號管理</a>
                                <a class="collapse-item" asp-controller="Staff" asp-action="InstructorList">營養師列表</a>
                            }
                            @if (canEditRoleFunctions)
                            {
                                <a class="collapse-item" asp-controller="Staff" asp-action="RoleFunctions">權限管理</a>
                            }
                            @if (canEditViolations)
                            {
                                <a class="collapse-item" asp-controller="MemberViolation" asp-action="Index">會員違規管理</a>
                            }
                        </div>
                    </div>
                </li>
            }
            
            @if (canEditInstructorShifts || canViewInstructorShifts || User.HasClaim(c => c.Type == "InstructorId") || canViewSalary || canViewSalary2)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">營養師管理</div>
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseTutor" aria-expanded="true" aria-controls="collapseTutor">
                        <i class="fa-regular fa-calendar-check"></i>
                        <span>班表與薪資管理</span>
                    </a>
                    <div id="collapseTutor" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            @if (canEditInstructorShifts)
                            {
                                <a class="collapse-item" asp-controller="Shift" asp-action="Index">營養師班表排程</a>
                            }
                            @if (canViewInstructorShifts)
                            {
                                <a class="collapse-item" asp-controller="Shift" asp-action="AllShifts">所有營養師班表(管理)</a>
                            }
                            @if (canViewSalary || canViewSalary2)
                            {
                                <a class="collapse-item" asp-controller="Salary" asp-action="Index">營養師薪資核算</a>
                            }
                            @if (User.HasClaim(c => c.Type == "InstructorId"))
                            {
                                <a class="collapse-item" asp-controller="Reservation" asp-action="Index">預約管理</a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canViewPointRecords || canViewClientFoodRecords || canViewClientBodyData)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">客戶管理</div>
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseClient"
                       aria-expanded="true" aria-controls="collapseClient">
                        <i class='bx bx-body'></i>
                        <span>客戶數據管理</span>
                    </a>
                    <div id="collapseClient" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            @if (canViewPointRecords)
                            {
                                <a class="collapse-item" asp-controller="PointsRecords" asp-action="Index">點數紀錄查詢</a>
                            }
                            @if (canViewClientFoodRecords)
                            {
                                <a class="collapse-item" asp-controller="Dashboard" asp-action="FoodRecords">客戶飲食紀錄</a>
                            }
                            @if (canViewClientBodyData)
                            {
                                <a class="collapse-item" asp-controller="Dashboard" asp-action="BodyData">客戶身體數據</a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canEditProductCategories || canEditProductsItems || canEditProductOrders || canEditPlans || canEditPlanOrders)
            {
                <hr class="sidebar-divider">

                <div class="sidebar-heading">商城營運</div>
                
                @if (canEditProductCategories || canEditProductsItems || canEditProductOrders)
                {
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseProduct" aria-expanded="true" aria-controls="collapseProduct">
                            <i class='bx bx-store'></i>
                            <span>商品管理</span>
                        </a>
                        <div id="collapseProduct" class="collapse" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                @if (canEditProductCategories)
                                {
                                    <a class="collapse-item" asp-controller="ProductCategories" asp-action="Index">類別管理</a>
                                }
                                @if (canEditProductsItems)
                                {
                                    <a class="collapse-item" asp-controller="Products" asp-action="Index">商品品項管理</a>
                                }
                                @if (canEditProductOrders)
                                {
                                    <a class="collapse-item" asp-controller="ProductOrders" asp-action="Dashboard">訂單管理</a>
                                }
                            </div>
                        </div>
                    </li>
                }

                @if (canEditPlans || canEditPlanOrders)
                {
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapsePlan" aria-expanded="true" aria-controls="collapsePlan">
                            <i class="fa-solid fa-wallet"></i>
                            <span>儲值方案管理</span>
                        </a>
                        <div id="collapsePlan" class="collapse" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                @if (canEditPlans)
                                {
                                    <a class="collapse-item" asp-controller="TopUpPlans" asp-action="Index">方案設定</a>
                                }
                                @if (canEditPlanOrders)
                                {
                                    <a class="collapse-item" asp-controller="PointOrders" asp-action="DashBoard">儲值訂單</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            }
            
            
            @if (canEditCommentsAdmin || canEditCommentsInstructor || canViewKeyWords || canEditKeyWords)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">其他工具</div>
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseOther"
                       aria-expanded="true" aria-controls="collapseOther">
                        <i class='bx bx-message-dots'></i>
                        <span>評論與字詞管理</span>
                    </a>
                    <div id="collapseOther" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            @if (canEditCommentsAdmin)
                            {
                                <a class="collapse-item" asp-controller="Review" asp-action="AdminIndex">評論區管理 </a>
                            }
                            @if (canEditCommentsInstructor)
                            {
                                <a class="collapse-item" asp-controller="Review" asp-action="InstructorIndex">評論區察看與舉報</a>
                            }
                            @if (canViewKeyWords || canEditKeyWords)
                            {
                                <a class="collapse-item" asp-controller="KeyWords" asp-action="Index">敏感字詞管理</a>
                            }
                        </div>
                    </div>
                </li>
            }

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            @if (User.Identity?.IsAuthenticated == true)
            {
                var account = User.FindFirst("Account")?.Value;
                var roles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(r => r.Value);
                var roleMapping = new Dictionary<string, string>
                {
                    { "member", "會員" },
                    { "instructor", "營養師" },
                    { "purchasor", "採購人員" },
                    { "marketor", "行銷人員" },
                    { "admin", "系統管理員" },
                    { "manager", "主管" }
                };
                var chineseRoles = string.Join(", ", roles.Select(r => roleMapping.ContainsKey(r) ? roleMapping[r] : r));

                <div class="sidebar-card sidebar-login-info d-none d-lg-flex flex-column align-items-start" style="padding: 1rem; margin: 0 1rem 1rem 1rem; background: rgba(255, 255, 255, 0.1); border-radius: 0.35rem;">
                    <div class="text-white-50 small mb-2">登入資訊</div>
                    <div class="text-white small mb-1">
                        <i class="fas fa-user-circle fa-fw mr-1"></i> @account
                    </div>
                    <div class="text-white small">
                        <i class="fas fa-user-tag fa-fw mr-1"></i> @chineseRoles
                    </div>
                </div>
            }

            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-3 static-top">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                    <div class="sidebar-brand-text d-flex justify-content-center font-weight-bold">MyFitnessCoach Admin</div>
                    <ul class="navbar-nav ml-auto">
                        <!-- Notifications Dropdown -->
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown no-arrow mx-1">
                                <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="bx bx-bell bx-sm"></i>
                                    <span class="badge badge-danger badge-counter d-none" id="notif-count">0</span>
                                </a>
                                <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                     aria-labelledby="alertsDropdown" style="min-width: 320px; max-height: 400px; overflow-y: auto;">
                                    <h6 class="dropdown-header bg-warning border-0 text-white font-weight-bold">
                                        <i class="bx bx-notification mr-2"></i>通知中心
                                    </h6>
                                    <div id="notif-list" style="max-height: 300px; overflow-y: auto;">
                                        <div class="dropdown-item text-center small text-gray-500 py-3">讀取中...</div>
                                    </div>
                                    <a class="dropdown-item text-center small text-gray-500 py-2 border-top" href="#" id="mark-all-read">
                                        全部標記為已讀
                                    </a>
                                </div>
                            </li>
                        }
                        

                        <span class="text-black mt-4">@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</span>
                        <div class="topbar-divider d-none d-sm-block"></div>
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity?.Name</span>
                                <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg">
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-chart-pie fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Dashboard
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    登出
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                @RenderBody()
            </div>
            @* <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; MyFitnessCoach 2026</span>
                    </div>
                </div>
            </footer> *@
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">確認登出</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">若要結束目前後台工作階段，請按下登出。</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @* @Html.AntiForgeryToken() *@
                        <button type="submit" class="btn btn-primary">登出</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>

    @RenderSection("scripts", required: false)
    <script>
        $(document).ready(function () {
            // 初始化與定時輪詢
            fetchNotifications();
            setInterval(fetchNotifications, 30000); // 30秒更新一次

            function fetchNotifications() {
                // 1. 取得未讀數量
                $.get('/api/notification/unread-count', function (data) {
                    if (data.count > 0) {
                        $('#notif-count').text(data.count > 99 ? '99+' : data.count).removeClass('d-none');
                    } else {
                        $('#notif-count').addClass('d-none');
                    }
                });

                // 2. 取得通知清單
                $.get('/api/notification', function (data) {
                    var $list = $('#notif-list');
                    $list.empty();

                    if (data.length === 0) {
                        $list.append('<div class="dropdown-item text-center small text-gray-500 py-3">目前無任何通知</div>');
                        return;
                    }

                    data.slice(0, 5).forEach(function (n) {
                        // 解析 Content，移除 [Url:...]
                        var displayMsg = n.content || "";
                        var targetUrl = "#";
                        var urlIdx = displayMsg.indexOf(" [Url:");
                        if (urlIdx >= 0) {
                            var urlEnd = displayMsg.indexOf("]", urlIdx);
                            targetUrl = displayMsg.substring(urlIdx + 6, urlEnd);
                            displayMsg = displayMsg.substring(0, urlIdx);
                        }

                        var dateStr = new Date(n.createdAt).toLocaleString();
                        var iconClass = "bx bx-info-circle text-primary";
                        var bgClass = n.isRead ? "" : "bg-light font-weight-bold";

                        if(n.notifyType === "Report1") iconClass = "bx bx-error text-danger";
                        if(n.notifyType === "Booking") iconClass = "bx bx-calendar-check text-success";

                        var item = `
                            <a class="dropdown-item d-flex align-items-center notif-item ${bgClass}" href="${targetUrl}" data-id="${n.id}">
                                <div class="mr-3">
                                    <div class="icon-circle">
                                        <i class="${iconClass}"></i>
                                    </div>
                                </div>
                                <div>
                                    <div class="small text-gray-500">${dateStr}</div>
                                    <span class="text-truncate" style="max-width: 220px; display: inline-block;">${n.title}: ${displayMsg}</span>
                                </div>
                            </a>
                        `;
                        $list.append(item);
                    });
                });
            }

            // 點擊通知標記為已讀
            $(document).on('click', '.notif-item', function (e) {
                var id = $(this).data('id');
                $.post('/api/notification/mark-as-read/' + id);
            });
        });
    </script>
</body>
</html>
