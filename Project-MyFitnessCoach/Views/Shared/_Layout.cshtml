<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="MyFitnessCoach Admin Dashboard">
    <meta name="author" content="MyFitnessCoach">
    <title>@(ViewData["Title"] ?? "MyFitnessCoach 後台")</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/layout-warm.css" rel="stylesheet">
    <style>
        /* 當 sidebar 縮小時隱藏登入資訊卡片 */
        .sidebar.toggled .sidebar-login-info {
            display: none !important;
        }
    </style>
    @RenderSection("styles", required: false)
    <script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-controller="Dashboard" asp-action="Index">
                <div class="sidebar-brand-text mx-3">@(ViewBag.Title ?? "後台管理")</div>
            </a>
            <br>
            <hr class="sidebar-divider">
            <li class="nav-item active">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                    <i class="bx bx-home-circle"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <br />

            <hr class="sidebar-divider">

            <div class="sidebar-heading">人員管理</div>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseUser" aria-expanded="true" aria-controls="collapseUser">
                    <i class="bx bx-user"></i>
                    <span>個人資料維護</span>
                </a>
                <div id="collapseUser" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-controller="Account" asp-action="ChangePassword">帳密修改</a>
                        <a class="collapse-item" asp-controller="Account" asp-action="InstructorDetails">資料維護-營養師</a>
                    </div>
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseStaff" aria-expanded="true" aria-controls="collapseTutor">
                    <i class="fa-solid fa-people-group"></i>
                    <span>帳號管理</span>
                </a>
                <div id="collapseStaff" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        
                        <a class="collapse-item" asp-controller="Staff" asp-action="Index">使用者帳號管理</a>
                        <a class="collapse-item" asp-controller="Staff" asp-action="RoleFunctions">權限管理</a>
                        <a class="collapse-item" asp-controller="Staff" asp-action="InstructorList">營養師列表</a>
                    </div>
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseTutor" aria-expanded="true" aria-controls="collapseTutor">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>班表管理</span>
                </a>
                <div id="collapseTutor" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        
                        <a class="collapse-item" href="cards.html">營養師班表排程</a>
                        <a class="collapse-item" href="cards.html">營養師班表查看</a>
                    </div>
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseClient"
                   aria-expanded="true" aria-controls="collapseClient">
                    <i class='bx bx-body'></i>
                    <span>客戶管理</span>
                </a>
                <div id="collapseClient" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" href="#">點數紀錄查詢</a>
                        <a class="collapse-item" asp-controller="FoodRecord" asp-action="ViewFoodRecord">客戶飲食紀錄查詢</a>
                        <a class="collapse-item" href="#">客戶體態數據查詢</a>
                    </div>
                </div>
            </li>

            <hr class="sidebar-divider">

            <div class="sidebar-heading">商城</div>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseProduct" aria-expanded="true" aria-controls="collapseTutor">
                    <i class='bx bx-store'></i>
                    <span>商品管理</span>
                </a>
                <div id="collapseProduct" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        
                        <a class="collapse-item" asp-controller="ProductCategories" asp-action="Index">類別管理</a>
                        <a class="collapse-item" asp-controller="Products" asp-action="Index">商品品項管理</a>
                        <a class="collapse-item" asp-controller="ProductOrders" asp-action="index">訂單管理</a>
                    </div>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapsePlan" aria-expanded="true" aria-controls="collapseTutor">
                    <i class="fa-solid fa-wallet"></i>
                    <span>方案管理</span>
                </a>
                <div id="collapsePlan" class="collapse" data-parent="#accordionSidebar">
                <div class="bg-white py-2 collapse-inner rounded">
                    
                        <a class="collapse-item" asp-controller="TopUpPlans" asp-action="Index">儲值方案管理</a>
                        <a class="collapse-item" asp-controller="PointOrders" asp-action="Index">儲值方案訂單管理</a>
                </div>
            </li>
            <!-- 客戶-->
            <hr class="sidebar-divider">

            <div class="sidebar-heading">其他</div>
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseOther"
                   aria-expanded="true" aria-controls="collapseOther">
                    <i class='bx bx-message-dots'></i>
                    <span>評論管理</span>
                </a>
                <div id="collapseOther" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        
                        <a class="collapse-item" href="tables.html">評論區管理-管理員</a>
                        <a class="collapse-item" href="cards.html">評論區察看與舉報-營養師</a>
                    </div>
                </div>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            @if (User.Identity?.IsAuthenticated == true)
            {
                var account = User.FindFirst("Account")?.Value;
                var roles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(r => r.Value);
                var roleMapping = new Dictionary<string, string>
                {
                    { "member", "會員" },
                    { "Instructor", "營養師" },
                    { "purchasor", "採購人員" },
                    { "marketor", "行銷人員" },
                    { "admin", "系統管理員" }
                };
                var chineseRoles = string.Join(", ", roles.Select(r => roleMapping.ContainsKey(r) ? roleMapping[r] : r));

                <div class="sidebar-card sidebar-login-info d-none d-lg-flex flex-column align-items-start" style="padding: 1rem; margin: 0 1rem 1rem 1rem; background: rgba(255, 255, 255, 0.1); border-radius: 0.35rem;">
                    <div class="text-white-50 small mb-2">登入資訊</div>
                    <div class="text-white small mb-1">
                        <i class="fas fa-user-circle fa-fw mr-1"></i> @account
                    </div>
                    <div class="text-white small">
                        <i class="fas fa-user-tag fa-fw mr-1"></i> @chineseRoles
                    </div>
                </div>
            }

            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                    <div class="sidebar-brand-text d-flex justify-content-center font-weight-bold">MyFitnessCoach Admin</div>
                    <ul class="navbar-nav ml-auto">
                        <span class="text-black mt-4">@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</span>
                        <div class="topbar-divider d-none d-sm-block"></div>
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity?.Name</span>
                                <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg">
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-chart-pie fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Dashboard
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    登出
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                @RenderBody()
            </div>
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; MyFitnessCoach 2026</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">確認登出</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">若要結束目前後台工作階段，請按下登出。</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @* @Html.AntiForgeryToken() *@
                        <button type="submit" class="btn btn-primary">登出</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
