@using Project_MyFitnessCoach.Models
@model ErrorViewModel
@{
    ViewData["Title"] = ViewBag.Title ?? "錯誤";
    Layout = "_Layout"; // 確保套用佈局
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            @if (ViewBag.StatusCode != null)
            {
                <h1 class="display-1 text-danger">@ViewBag.StatusCode</h1>
            }
            else
            {
                <h1 class="display-1 text-danger">Error</h1>
            }
            
            <h2 class="mb-4">@ViewBag.Title</h2>
            <p class="lead mb-5">@ViewBag.Message</p>

            <div class="mb-4">
                <a href="@ViewBag.LinkUrl" class="btn btn-primary btn-lg">@ViewBag.LinkText</a>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="text-muted small mt-5">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }
        </div>
    </div>
</div>
