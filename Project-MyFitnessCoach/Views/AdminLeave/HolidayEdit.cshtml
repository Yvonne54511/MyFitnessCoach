@model Project_MyFitnessCoach.Models.ViewModels.HolidayEditViewModel

@{
    ViewData["Title"] = "編輯國定假日";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="bx bx-calendar-edit"></i> @ViewData["Title"]</h2>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bx bx-error-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="bx bx-edit"></i> 假日資料
                    </h6>
                </div>
                <div class="card-body">
                    <form asp-action="HolidayEdit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group">
                            <label asp-for="HolidayDate" class="form-label"></label>
                            <input asp-for="HolidayDate" type="date" class="form-control" />
                            <span asp-validation-for="HolidayDate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">啟用</label>
                        </div>

                        <hr />
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save"></i> 儲存變更
                        </button>
                        <a asp-action="HolidayList" asp-route-year="@Model.HolidayDate.Year" class="btn btn-secondary ml-2">
                            <i class="bx bx-arrow-back"></i> 返回列表
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
