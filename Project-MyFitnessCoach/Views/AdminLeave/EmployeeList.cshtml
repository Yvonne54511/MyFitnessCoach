@using Project_MyFitnessCoach.Models.ViewModels
@model EmployeeListViewModel

@{
    ViewData["Title"] = "員工管理";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="bx bx-group"></i> @ViewData["Title"]</h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle mr-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- 篩選列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="EmployeeList" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">部門</label>
                    <select name="departmentFilter" class="form-control">
                        @foreach (var opt in Model.DepartmentOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.DepartmentFilter)">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">搜尋</label>
                    <input type="text" name="searchKeyword" class="form-control" value="@Model.SearchKeyword" placeholder="姓名或帳號..." />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-search-alt"></i> 篩選
                    </button>
                    <a asp-action="EmployeeList" class="btn btn-outline-secondary">
                        <i class="bx bx-reset"></i> 重置
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- 表格 -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th>ID</th>
                            <th>姓名</th>
                            <th>帳號</th>
                            <th>部門</th>
                            <th>直屬主管</th>
                            <th>代理人</th>
                            <th>到職日</th>
                            <th>狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Employees != null && Model.Employees.Any())
                        {
                            foreach (var emp in Model.Employees)
                            {
                                <tr class="text-center">
                                    <td>@emp.Id</td>
                                    <td>@emp.UserName</td>
                                    <td>@emp.Account</td>
                                    <td>@emp.DepartmentName</td>
                                    <td>@(emp.ManagerName ?? "-")</td>
                                    <td>@(emp.WorkDelegateName ?? "-")</td>
                                    <td>@emp.HiredDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge badge-success">啟用</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">停用</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="EmployeeEdit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bx bx-edit"></i> 編輯
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">無符合條件的記錄</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
