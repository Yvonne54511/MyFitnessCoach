@{
    Layout = null;
    string email = ViewBag.Email as string ?? "您的信箱";
}
<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>MyFitnessCoach - 還差一步</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:400,600,700,800&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/Login.css" rel="stylesheet">
</head>

<body>
    <div class="login-wrapper">
        <div class="login-left">
            <img src="~/img/LoginPhoto.png" alt="圖片" />
            <div class="login-left-text text-secondary">
                <br /><br /><br />
                <h2>陪你養成<br />一輩子的好習慣</h2>
            </div>
        </div>

        <div class="login-right">
            <div class="text-center">
                <i class="fas fa-envelope-open-text fa-4x text-warning mb-4"></i>
                <h1 class="h3 text-gray-900 mb-4">還差一步!</h1>
                <p class="mb-4">
                    請至 <strong class="text-primary">[@email]</strong> 收取驗證信，<br />
                    並點選信中的連結以啟用您的帳號。
                </p>
                <hr>
                <div class="login-links mt-3">
                    <a asp-action="Login" asp-controller="Auth">返回登入頁面</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
