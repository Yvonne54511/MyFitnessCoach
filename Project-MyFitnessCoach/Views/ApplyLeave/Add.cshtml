@using Project_MyFitnessCoach.Models.ViewModels
@model AddLeaveViewModel

@{
    ViewData["Title"] = "新增請假申請";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="bx bx-calendar-plus"></i> @ViewData["Title"]</h2>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <form asp-action="Add" method="post" id="leaveForm">

        <!-- 區塊一：申請人資訊 -->
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="bx bx-user"></i> 申請人資訊（自動帶入）
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label text-muted">姓名</label>
                            <input type="text" class="form-control" value="@Model.EmployeeName" disabled />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label text-muted">部門</label>
                            <input type="text" class="form-control" value="@Model.DepartmentName" disabled />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label text-muted">直屬主管</label>
                            <input type="text" class="form-control" value="@Model.ManagerName" disabled />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 假別餘額（步驟 4.3-1：依 QuotaType 分別顯示）-->
        @if (Model.Balances != null && Model.Balances.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="bx bx-bar-chart-alt-2"></i> 今年度假別餘額
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var b in Model.Balances)
                        {
                            var isOverThreshold = b.WarnThresholdDays.HasValue && b.UsedDays >= b.WarnThresholdDays.Value;
                            var borderClass = isOverThreshold ? "border-left-danger" : "border-left-info";
                            <div class="col-md-3 col-sm-6 mb-3">
                                <div class="card @borderClass h-100 py-2">
                                    <div class="card-body py-2">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">@b.LeaveTypeName</div>
                                        @if (b.QuotaType == "PreAllocated")
                                        {
                                            <div class="h6 mb-0 font-weight-bold text-gray-800">
                                                剩餘 <span class="text-primary">@b.RemainingDays.ToString("0.##")</span> 天
                                            </div>
                                            <div class="small text-muted">已用 @b.UsedDays.ToString("0.##") / @b.TotalDays.ToString("0.##") 天</div>
                                        }
                                        else if (b.QuotaType == "Unlimited")
                                        {
                                            @if (b.WarnThresholdDays.HasValue)
                                            {
                                                <div class="h6 mb-0 font-weight-bold @(isOverThreshold ? "text-danger" : "text-gray-800")">
                                                    已用 <span class="@(isOverThreshold ? "text-danger" : "text-warning")">@b.UsedDays.ToString("0.##")</span>
                                                    / @b.WarnThresholdDays 天
                                                </div>
                                                <div class="small text-muted">不限額度（超過 @b.WarnThresholdDays 天影響薪資）</div>
                                                @if (isOverThreshold)
                                                {
                                                    <div class="small text-danger mt-1">
                                                        <i class="bx bx-error-circle"></i> 已超過法定半薪門檻
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="h6 mb-0 font-weight-bold text-gray-800">
                                                    已用 <span class="text-warning">@b.UsedDays.ToString("0.##")</span> 天
                                                </div>
                                                <div class="small text-muted">不限額度</div>
                                            }
                                        }
                                        else if (b.QuotaType == "ApprovalRequired")
                                        {
                                            @if (b.TotalDays > 0)
                                            {
                                                <div class="h6 mb-0 font-weight-bold text-gray-800">
                                                    剩餘 <span class="text-primary">@b.RemainingDays.ToString("0.##")</span> 天
                                                </div>
                                                <div class="small text-muted">已用 @b.UsedDays.ToString("0.##") / @b.TotalDays.ToString("0.##") 天</div>
                                            }
                                            else
                                            {
                                                <div class="h6 mb-0 font-weight-bold text-danger">尚未取得額度</div>
                                                <div class="small text-muted">需提交證明文件</div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- 區塊二：請假內容 -->
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="bx bx-edit"></i> 請假內容
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="LeaveTypeId" class="form-label"></label>
                            <select asp-for="LeaveTypeId" asp-items="Model.LeaveTypeOptions" class="form-control">
                                <option value="">-- 請選擇假別 --</option>
                            </select>
                            <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="LeaveDelegateId" class="form-label"></label>
                            <select asp-for="LeaveDelegateId" class="form-control" id="delegateSelect">
                                <option value="">-- 不指定 --</option>
                                @foreach (var opt in Model.DelegateOptions.Where(o => !string.IsNullOrEmpty(o.Value)))
                                {
                                    <option value="@opt.Value" selected="@(opt.Value == Model.LeaveDelegateId?.ToString())">@opt.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @* 步驟 5.2: 主管代審人選單 *@
                @if (Model.IsManager)
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <span class="text-danger">*</span> 代審人（主管請假必填）
                                </label>
                                <select asp-for="ApprovingDelegateId" class="form-control" id="approvingDelegateSelect">
                                    <option value="">-- 請選擇代審人 --</option>
                                    @foreach (var sub in Model.SubordinateOptions)
                                    {
                                        <option value="@sub.Value">@sub.Text</option>
                                    }
                                </select>
                                <small class="form-text text-muted">
                                    您的假單將自動核准。代審人將在您的假期期間代為審核下屬假單。
                                </small>
                            </div>
                        </div>
                    </div>
                }

                <!-- 代理人警告 -->
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-warning" id="delegateWarning" style="display:none;">
                            <i class="bx bx-error"></i> <span id="delegateWarningText"></span>
                        </div>
                    </div>
                </div>

                <!-- 步驟 4.3-2: 開始時間（日期 + 小時） -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">開始時間</label>
                            <div class="input-group">
                                <input asp-for="StartDate" type="date" class="form-control" id="startDate" />
                                <select asp-for="StartHour" class="form-control" id="startHour" style="max-width:120px;">
                                    <option value="9">09:00</option>
                                    <option value="10">10:00</option>
                                    <option value="11">11:00</option>
                                    <option value="13">13:00</option>
                                    <option value="14">14:00</option>
                                    <option value="15">15:00</option>
                                    <option value="16">16:00</option>
                                    <option value="17">17:00</option>
                                </select>
                            </div>
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">結束時間</label>
                            <div class="input-group">
                                <input asp-for="EndDate" type="date" class="form-control" id="endDate" />
                                <select asp-for="EndHour" class="form-control" id="endHour" style="max-width:120px;">
                                    <option value="10">10:00</option>
                                    <option value="11">11:00</option>
                                    <option value="12">12:00</option>
                                    <option value="13">13:00</option>
                                    <option value="14">14:00</option>
                                    <option value="15">15:00</option>
                                    <option value="16">16:00</option>
                                    <option value="17">17:00</option>
                                    <option value="18">18:00</option>
                                </select>
                            </div>
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- 自動計算結果（唯讀顯示） -->
                <div class="row mt-2">
                    <div class="col-md-12">
                        <div class="alert alert-info py-2" id="calcResult" style="display:none;">
                            <i class="bx bx-calculator"></i>
                            請假時數：<strong id="calcHours">0</strong> 小時
                            （折合 <strong id="calcDays">0.00</strong> 天）
                        </div>
                    </div>
                </div>

                <!-- Hidden：將自動計算的 HoursUsed 傳給後端 -->
                <input type="hidden" asp-for="HoursUsed" id="hoursUsedHidden" />

                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="Reason" class="form-label"></label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="請輸入請假原因..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 按鈕 -->
        <div class="d-flex justify-content-end mb-4">
            <a asp-action="List" class="btn btn-secondary mr-2">
                <i class="bx bx-arrow-back"></i> 取消
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bx bx-send"></i> 送出申請
            </button>
        </div>
    </form>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var defaultDelegateId = @(Model.DefaultDelegateId?.ToString() ?? "null");

            // 國定假日清單（由後端傳入）
            var holidays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Holidays));

            function isHoliday(dateStr) {
                return holidays.indexOf(dateStr) >= 0;
            }

            // 步驟 4.3-2: 計算請假時數（前端預覽用，後端為最終依據）
            function calculateBusinessHours() {
                var startDateStr = $('#startDate').val();
                var endDateStr = $('#endDate').val();
                var startHour = parseInt($('#startHour').val());
                var endHour = parseInt($('#endHour').val());

                if (!startDateStr || !endDateStr) {
                    $('#calcResult').hide();
                    return;
                }

                var start = new Date(startDateStr);
                var end = new Date(endDateStr);

                if (end < start || (end.getTime() === start.getTime() && endHour <= startHour)) {
                    $('#calcResult').hide();
                    return;
                }

                var totalHours = 0;
                var current = new Date(start);

                while (current <= end) {
                    var day = current.getDay();
                    var dateKey = current.toISOString().slice(0, 10);

                    if (day !== 0 && day !== 6 && !isHoliday(dateKey)) {
                        var isStartDay = current.getTime() === start.getTime();
                        var isEndDay = current.getTime() === end.getTime();
                        var dayStartH = isStartDay ? startHour : 9;
                        var dayEndH = isEndDay ? endHour : 18;

                        // 上午：09~12
                        var amStart = Math.max(dayStartH, 9);
                        var amEnd = Math.min(dayEndH, 12);
                        if (amEnd > amStart) totalHours += (amEnd - amStart);

                        // 下午：13~18
                        var pmStart = Math.max(dayStartH, 13);
                        var pmEnd = Math.min(dayEndH, 18);
                        if (pmEnd > pmStart) totalHours += (pmEnd - pmStart);
                    }
                    current.setDate(current.getDate() + 1);
                }

                if (totalHours > 0) {
                    $('#calcHours').text(totalHours);
                    $('#calcDays').text((totalHours / 8).toFixed(2));
                    $('#hoursUsedHidden').val(totalHours);
                    $('#calcResult').show();
                } else {
                    $('#calcResult').hide();
                    $('#hoursUsedHidden').val(0);
                }
            }

            // 日期/小時變更時：更新計算 + 代理人判斷
            function onDateChange() {
                calculateBusinessHours();

                var start = $('#startDate').val();
                var end = $('#endDate').val();
                if (!start || !end) return;

                var s = new Date(start);
                var e = new Date(end);
                if (e < s) return;

                // AJAX：取得可用代理人（排除請假中的同事）
                $.get('@Url.Action("GetAvailableDelegates", "ApplyLeave")', {
                    startDate: start,
                    endDate: end
                }, function (data) {
                    var select = $('#delegateSelect');
                    var currentVal = select.val();
                    select.empty();
                    select.append('<option value="">-- 不指定 --</option>');
                    $.each(data, function (i, item) {
                        select.append('<option value="' + item.value + '">' + item.text + '</option>');
                    });
                    if (select.find('option[value="' + currentVal + '"]').length > 0) {
                        select.val(currentVal);
                    }
                });

                // AJAX：檢查預設代理人是否請假
                if (defaultDelegateId) {
                    $.get('@Url.Action("CheckDefaultDelegate", "ApplyLeave")', {
                        startDate: start,
                        endDate: end
                    }, function (data) {
                        if (data.hasDefault && data.onLeave) {
                            $('#delegateWarningText').text(
                                '您的預設代理人「' + data.delegateName + '」在此期間有請假，請另選代理人。'
                            );
                            $('#delegateWarning').show();
                        } else {
                            $('#delegateWarning').hide();
                            if (data.hasDefault && !data.onLeave) {
                                var select = $('#delegateSelect');
                                if (select.find('option[value="' + data.delegateId + '"]').length > 0) {
                                    select.val(data.delegateId);
                                }
                            }
                        }
                    });
                }
            }

            $('#startDate, #endDate, #startHour, #endHour').on('change', onDateChange);

            // 步驟 5.2: 主管代審人必填驗證
            var isManager = @(Model.IsManager ? "true" : "false");
            $('#leaveForm').on('submit', function (e) {
                if (isManager && !$('#approvingDelegateSelect').val()) {
                    e.preventDefault();
                    alert('主管請假必須指定代審人');
                    return false;
                }
            });

            // 初始化
            onDateChange();
        });
    </script>
}
