@using Project_MyFitnessCoach.Models.ViewModels
@model LeaveListViewModel

@{
    ViewData["Title"] = "我的請假申請";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="bx bx-calendar-x"></i> @ViewData["Title"]</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Add" class="btn btn-primary">
                <i class="bx bx-plus"></i> 新增申請
            </a>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row">
        @await Html.PartialAsync("_StatCard", ("今年已請天數", Model.Stats.TotalDaysThisYear.ToString("0.#") + " 天", "bx bx-calendar-check", "primary"))
        @await Html.PartialAsync("_StatCard", ("待審核", Model.Stats.PendingCount.ToString(), "bx bx-time-five", "warning"))
        @await Html.PartialAsync("_StatCard", ("已核准", Model.Stats.ApprovedCount.ToString(), "bx bx-check-circle", "success"))
        @await Html.PartialAsync("_StatCard", ("已駁回", Model.Stats.RejectedCount.ToString(), "bx bx-x-circle", "danger"))
        @await Html.PartialAsync("_StatCard", ("取消審核中", Model.Stats.CancelPendingCount.ToString(), "bx bx-revision", "info"))
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle mr-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- 篩選列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="List" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">狀態篩選</label>
                    <select name="statusFilter" class="form-control">
                        <option value="">全部</option>
                        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">待審核</option>
                        <option value="Approved" selected="@(Model.StatusFilter == "Approved")">已核准</option>
                        <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">已駁回</option>
                        <option value="CancelPending" selected="@(Model.StatusFilter == "CancelPending")">取消審核中</option>
                        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">已取消</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">月份篩選</label>
                    <input type="month" name="monthFilter" class="form-control" value="@Model.MonthFilter" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-search-alt"></i> 篩選
                    </button>
                    <a asp-action="List" class="btn btn-outline-secondary">
                        <i class="bx bx-reset"></i> 重置
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- 申請列表 -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="leaveTable">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th>申請單號</th>
                            <th>假別</th>
                            <th>開始日期</th>
                            <th>結束日期</th>
                            <th>時數 / 天數</th>
                            <th>狀態</th>
                            <th>申請時間</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Requests != null && Model.Requests.Any())
                        {
                            foreach (var req in Model.Requests)
                            {
                                <tr class="text-center">
                                    <td>@req.Id</td>
                                    <td>@req.LeaveTypeName</td>
                                    <td>@req.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@req.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td>@req.HoursUsed.ToString("0.#") 小時 / @req.DaysUsed.ToString("0.#") 天</td>
                                    <td>
                                        @await Html.PartialAsync("_LeaveStatusBadge", req.Status)
                                    </td>
                                    <td>@req.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-info"
                                                data-toggle="modal" data-target="#detailModal-@req.Id">
                                            <i class="bx bx-info-circle"></i> 詳情
                                        </button>
                                        @if (req.CanCancel)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-toggle="modal" data-target="#cancelModal-@req.Id">
                                                <i class="bx bx-x"></i> 取消
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">目前沒有請假申請記錄</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 詳情 Modal -->
@if (Model.Requests != null)
{
    foreach (var req in Model.Requests)
    {
        <div class="modal fade" id="detailModal-@req.Id" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bx bx-detail"></i> 請假申請詳情 #@req.Id
                        </h5>
                        <button type="button" class="close" data-dismiss="modal">
                            <span>&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-borderless">
                                    <tr><th class="text-muted">申請人</th><td>@req.EmployeeName</td></tr>
                                    <tr><th class="text-muted">部門</th><td>@req.DepartmentName</td></tr>
                                    <tr><th class="text-muted">假別</th><td>@req.LeaveTypeName</td></tr>
                                    <tr><th class="text-muted">請假日期</th><td>@req.StartDate.ToString("yyyy-MM-dd") ~ @req.EndDate.ToString("yyyy-MM-dd")</td></tr>
                                    <tr><th class="text-muted">時數</th><td>@req.HoursUsed.ToString("0.#") 小時（@req.DaysUsed.ToString("0.#") 天）</td></tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-borderless">
                                    <tr><th class="text-muted">請假原因</th><td>@(req.Reason ?? "-")</td></tr>
                                    <tr><th class="text-muted">代理人</th><td>@(req.DelegateName ?? "未指定")</td></tr>
                                    <tr>
                                        <th class="text-muted">狀態</th>
                                        <td>@await Html.PartialAsync("_LeaveStatusBadge", req.Status)</td>
                                    </tr>
                                    @if (req.ApproverName != null)
                                    {
                                        <tr><th class="text-muted">審核人</th><td>@req.ApproverName</td></tr>
                                        <tr><th class="text-muted">審核時間</th><td>@req.ApprovedAt?.ToString("yyyy-MM-dd HH:mm")</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(req.RejectReason))
                                    {
                                        <tr><th class="text-muted text-danger">駁回原因</th><td class="text-danger">@req.RejectReason</td></tr>
                                    }
                                    @if (req.Status == "CancelPending")
                                    {
                                        <tr><th class="text-muted text-warning">取消原因</th><td>@req.CancelReason</td></tr>
                                        <tr><th class="text-muted">取消申請時間</th><td>@req.CancelRequestedAt?.ToString("yyyy-MM-dd HH:mm")</td></tr>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">關閉</button>
                    </div>
                </div>
            </div>
        </div>

        @* 取消請假 Modal *@
        @if (req.CanCancel)
        {
            <div class="modal fade" id="cancelModal-@req.Id" tabindex="-1" role="dialog">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <form asp-action="CancelRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    <i class="bx bx-x-circle text-danger"></i> 取消請假申請 #@req.Id
                                </h5>
                                <button type="button" class="close" data-dismiss="modal">
                                    <span>&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p>確定要取消此假單嗎？取消後需經主管審核。</p>
                                <div class="form-group">
                                    <label class="form-label">取消原因 <span class="text-danger">*</span></label>
                                    <textarea name="cancelReason" class="form-control" rows="3"
                                              placeholder="請輸入取消原因..." required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">返回</button>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bx bx-x"></i> 確認取消
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}
