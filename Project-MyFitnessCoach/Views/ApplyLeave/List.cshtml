@using Project_MyFitnessCoach.Models.ViewModels
@model LeaveListViewModel

@{
    ViewData["Title"] = "我的請假申請";
    var activeFilter = Model.StatusFilter ?? "";
}

@section styles {
<style>
    /* ===== SaaS Dashboard — ApplyLeave/List ===== */

    /* ---------- Page header ---------- */
    .leave-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 28px;
    }
    .leave-page-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--warm-text, #3f2d1f);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .leave-page-header h2 i { font-size: 1.6rem; }

    .btn-add-leave {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 22px;
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: 10px;
        border: none;
        color: #fff;
        background: linear-gradient(135deg, var(--warm-accent-dark, #e47b22), var(--warm-accent, #f2a531));
        box-shadow: 0 4px 14px rgba(228, 123, 34, 0.3);
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-add-leave:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(228, 123, 34, 0.4);
        color: #fff;
        text-decoration: none;
    }

    /* ---------- KPI Cards ---------- */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }
    @@media (max-width: 992px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 576px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }

    .kpi-card {
        position: relative;
        padding: 22px 24px;
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid var(--warm-border, rgba(0,0,0,0.08));
        box-shadow: var(--warm-shadow, 0 1px 3px rgba(0,0,0,0.06));
        transition: all 0.25s ease;
        overflow: hidden;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--warm-shadow-md, 0 4px 12px rgba(0,0,0,0.08));
    }
    .kpi-card__icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 14px;
    }
    .kpi-card__value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 4px;
    }
    .kpi-card__label {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--warm-text-soft, #7a614d);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    /* Pending — dominant */
    .kpi-card--pending {
        background: #fffbf5;
        border: 2px solid var(--warm-accent, #f2a531);
        box-shadow: 0 2px 12px rgba(242,165,49,0.12);
    }
    .kpi-card--pending .kpi-card__icon {
        background: rgba(242,165,49,0.15);
        color: var(--warm-accent-dark, #e47b22);
    }
    .kpi-card--pending .kpi-card__value { color: var(--warm-accent-dark, #e47b22); }
    .kpi-card--pending::after {
        content: '';
        position: absolute;
        top: 0; right: 0;
        width: 80px; height: 80px;
        background: radial-gradient(circle, rgba(242,165,49,0.12), transparent 70%);
        border-radius: 0 14px 0 0;
    }

    /* Approved */
    .kpi-card--approved .kpi-card__icon {
        background: rgba(40,167,69,0.12);
        color: #28a745;
    }
    .kpi-card--approved .kpi-card__value { color: #28a745; }

    /* Rejected */
    .kpi-card--rejected .kpi-card__icon {
        background: rgba(220,53,69,0.1);
        color: #dc3545;
    }
    .kpi-card--rejected .kpi-card__value { color: #dc3545; }

    /* Total days */
    .kpi-card--total .kpi-card__icon {
        background: rgba(108,117,125,0.1);
        color: #6c757d;
    }
    .kpi-card--total .kpi-card__value { color: var(--warm-text, #1e293b); }

    /* ---------- Filter Section ---------- */
    .filter-section {
        background: #ffffff;
        border: 1px solid var(--warm-border, rgba(0,0,0,0.08));
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: var(--warm-shadow, 0 1px 3px rgba(0,0,0,0.06));
    }
    .filter-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }
    .filter-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50px;
        border: 1.5px solid #e2e8f0;
        background: transparent;
        color: var(--warm-text-soft, #64748b);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .filter-tab:hover {
        background: rgba(242,165,49,0.06);
        border-color: rgba(242,165,49,0.35);
        color: var(--warm-accent-dark, #e47b22);
        text-decoration: none;
    }
    .filter-tab.active {
        background: var(--warm-accent-dark, #e47b22);
        border-color: var(--warm-accent-dark, #e47b22);
        color: #fff;
    }
    .filter-tab .badge-count {
        font-size: 0.7rem;
        padding: 2px 7px;
        border-radius: 50px;
        font-weight: 700;
        background: rgba(0,0,0,0.08);
    }
    .filter-tab.active .badge-count {
        background: rgba(255,255,255,0.25);
        color: #fff;
    }

    .filter-controls {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .filter-controls .form-control {
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        padding: 8px 14px;
        font-size: 0.85rem;
        background: #ffffff;
        transition: border-color 0.2s;
        max-width: 200px;
    }
    .filter-controls .form-control:focus {
        border-color: var(--warm-accent, #f2a531);
        box-shadow: 0 0 0 3px rgba(242,165,49,0.12);
    }
    .btn-filter {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        font-size: 0.84rem;
        font-weight: 600;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-filter--primary {
        background: var(--warm-accent-dark, #e47b22);
        color: #fff;
    }
    .btn-filter--primary:hover {
        background: #cc6919;
        box-shadow: 0 3px 10px rgba(228,123,34,0.25);
    }
    .btn-filter--ghost {
        background: transparent;
        color: var(--warm-text-soft, #64748b);
        border: 1.5px solid #e2e8f0;
        text-decoration: none;
    }
    .btn-filter--ghost:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: var(--warm-text, #1e293b);
        text-decoration: none;
    }

    /* ---------- Table ---------- */
    .table-card {
        background: #ffffff;
        border: 1px solid var(--warm-border, rgba(0,0,0,0.08));
        border-radius: 14px;
        box-shadow: var(--warm-shadow, 0 1px 3px rgba(0,0,0,0.06));
        overflow: hidden;
    }
    .table-card .table-responsive {
        margin: 0;
    }

    .leave-table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }
    .leave-table thead th {
        background: #fafafa;
        border-bottom: 2px solid #e2e8f0;
        padding: 14px 16px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--warm-text-soft, #64748b);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        border-top: none;
    }
    .leave-table tbody td {
        padding: 16px 16px;
        font-size: 0.875rem;
        vertical-align: middle;
        border-top: 1px solid #f1f5f9;
        transition: background 0.15s ease;
    }
    .leave-table tbody tr:hover td {
        background: #f8fafc;
    }
    .leave-table tbody tr:nth-child(even) td {
        background: #fafbfc;
    }
    .leave-table tbody tr:nth-child(even):hover td {
        background: #f1f5f9;
    }

    .leave-table .td-id {
        font-weight: 700;
        color: var(--warm-text, #1e293b);
        font-variant-numeric: tabular-nums;
    }
    .leave-table .td-type {
        font-weight: 600;
    }
    .leave-table .td-date {
        font-variant-numeric: tabular-nums;
        color: var(--warm-text-soft, #64748b);
        white-space: nowrap;
    }
    .leave-table .td-duration {
        font-weight: 600;
        white-space: nowrap;
    }
    .leave-table .td-time {
        font-size: 0.8rem;
        color: var(--warm-text-soft, #64748b);
        white-space: nowrap;
    }

    /* ---------- Action Buttons ---------- */
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-action--view {
        background: transparent;
        color: var(--warm-text-soft, #64748b);
        border: 1px solid #e2e8f0;
    }
    .btn-action--view:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: var(--warm-text, #1e293b);
    }
    .btn-action--cancel {
        background: transparent;
        color: rgba(220,53,69,0.6);
        border: 1px solid transparent;
    }
    .btn-action--cancel:hover {
        background: rgba(220,53,69,0.08);
        border-color: rgba(220,53,69,0.2);
        color: #dc3545;
    }

    /* ---------- Empty state ---------- */
    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }
    .empty-state__icon {
        font-size: 3rem;
        color: #cbd5e1;
        margin-bottom: 12px;
    }
    .empty-state__text {
        font-size: 0.95rem;
        color: var(--warm-text-soft, #64748b);
    }

    /* ---------- Alerts ---------- */
    .leave-alert {
        border-radius: 12px;
        border: none;
        padding: 14px 20px;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .leave-alert--success {
        background: rgba(40,167,69,0.1);
        color: #1e7e34;
    }
    .leave-alert--error {
        background: rgba(220,53,69,0.1);
        color: #c82333;
    }
    .leave-alert .close {
        opacity: 0.6;
        text-shadow: none;
        margin-left: auto;
        padding: 0;
    }
    .leave-alert .close:hover { opacity: 1; }

    /* ---------- Modal enhancements ---------- */
    .modal-content {
        border-radius: 16px !important;
        border: none !important;
        overflow: hidden;
    }
    .modal-header {
        border-bottom: 1px solid #e2e8f0 !important;
        padding: 18px 24px !important;
    }
    .modal-header .modal-title {
        font-size: 1.05rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .modal-body {
        padding: 24px !important;
    }
    .modal-footer {
        border-top: 1px solid #e2e8f0 !important;
        padding: 16px 24px !important;
    }
    .detail-table th {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--warm-text-soft, #64748b);
        padding: 8px 12px 8px 0;
        width: 110px;
        white-space: nowrap;
    }
    .detail-table td {
        font-size: 0.875rem;
        padding: 8px 0;
        color: var(--warm-text, #1e293b);
    }
    .btn-modal-close {
        padding: 8px 20px;
        border-radius: 10px;
        font-size: 0.84rem;
        font-weight: 600;
        border: 1.5px solid #e2e8f0;
        background: transparent;
        color: var(--warm-text-soft, #64748b);
        transition: all 0.2s;
    }
    .btn-modal-close:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }
    .btn-modal-danger {
        padding: 8px 20px;
        border-radius: 10px;
        font-size: 0.84rem;
        font-weight: 600;
        border: none;
        background: #dc3545;
        color: #fff;
        transition: all 0.2s;
    }
    .btn-modal-danger:hover {
        background: #c82333;
        box-shadow: 0 3px 10px rgba(220,53,69,0.25);
        color: #fff;
    }
</style>
}

<div class="container-fluid" style="padding-top: 8px;">
    <!-- Page Header -->
    <div class="leave-page-header">
        <h2><i class="bx bx-calendar-x"></i> @ViewData["Title"]</h2>
        <a asp-action="Add" class="btn-add-leave">
            <i class="bx bx-plus"></i> 新增申請
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="leave-alert leave-alert--success alert alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle" style="font-size:1.2rem"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="leave-alert leave-alert--error alert alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle" style="font-size:1.2rem"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <!-- Pending (dominant) -->
        <div class="kpi-card kpi-card--pending">
            <div class="kpi-card__icon">
                <i class="bx bx-time-five"></i>
            </div>
            <div class="kpi-card__value">@Model.Stats.PendingCount</div>
            <div class="kpi-card__label">待審核</div>
        </div>
        <!-- Approved -->
        <div class="kpi-card kpi-card--approved">
            <div class="kpi-card__icon">
                <i class="bx bx-check-circle"></i>
            </div>
            <div class="kpi-card__value">@Model.Stats.ApprovedCount</div>
            <div class="kpi-card__label">已核准</div>
        </div>
        <!-- Rejected -->
        <div class="kpi-card kpi-card--rejected">
            <div class="kpi-card__icon">
                <i class="bx bx-x-circle"></i>
            </div>
            <div class="kpi-card__value">@Model.Stats.RejectedCount</div>
            <div class="kpi-card__label">已駁回</div>
        </div>
        <!-- Total Days -->
        <div class="kpi-card kpi-card--total">
            <div class="kpi-card__icon">
                <i class="bx bx-calendar-check"></i>
            </div>
            <div class="kpi-card__value">@Model.Stats.TotalDaysThisYear.ToString("0.#")</div>
            <div class="kpi-card__label">今年已請天數</div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <form method="get" asp-action="List" id="filterForm">
            <input type="hidden" name="statusFilter" id="hiddenStatusFilter" value="@Model.StatusFilter" />
            <div class="filter-tabs">
                @{
                    var totalCount = Model.Stats.PendingCount + Model.Stats.ApprovedCount
                                   + Model.Stats.RejectedCount + Model.Stats.CancelPendingCount;
                }
                <a href="javascript:void(0)" class="filter-tab @(activeFilter == "" ? "active" : "")"
                   data-status="">
                    全部 <span class="badge-count">@totalCount</span>
                </a>
                <a href="javascript:void(0)" class="filter-tab @(activeFilter == "Pending" ? "active" : "")"
                   data-status="Pending">
                    <i class="bx bx-time-five"></i> 待審核 <span class="badge-count">@Model.Stats.PendingCount</span>
                </a>
                <a href="javascript:void(0)" class="filter-tab @(activeFilter == "Approved" ? "active" : "")"
                   data-status="Approved">
                    <i class="bx bx-check-circle"></i> 已核准 <span class="badge-count">@Model.Stats.ApprovedCount</span>
                </a>
                <a href="javascript:void(0)" class="filter-tab @(activeFilter == "Rejected" ? "active" : "")"
                   data-status="Rejected">
                    <i class="bx bx-x-circle"></i> 已駁回 <span class="badge-count">@Model.Stats.RejectedCount</span>
                </a>
                <a href="javascript:void(0)" class="filter-tab @(activeFilter == "CancelPending" ? "active" : "")"
                   data-status="CancelPending">
                    <i class="bx bx-revision"></i> 取消審核中 <span class="badge-count">@Model.Stats.CancelPendingCount</span>
                </a>
                <a href="javascript:void(0)" class="filter-tab @(activeFilter == "Cancelled" ? "active" : "")"
                   data-status="Cancelled">
                    <i class="bx bx-block"></i> 已取消
                </a>
            </div>
            <div class="filter-controls">
                <input type="month" name="monthFilter" class="form-control"
                       value="@Model.MonthFilter" placeholder="選擇月份" />
                <button type="submit" class="btn-filter btn-filter--primary">
                    <i class="bx bx-search-alt"></i> 篩選
                </button>
                <a asp-action="List" class="btn-filter btn-filter--ghost">
                    <i class="bx bx-reset"></i> 重置
                </a>
            </div>
        </form>
    </div>

    <!-- Leave Table -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="table leave-table" id="leaveTable">
                <thead>
                    <tr class="text-center">
                        <th>單號</th>
                        <th>假別</th>
                        <th>開始日期</th>
                        <th>結束日期</th>
                        <th>時數 / 天數</th>
                        <th>狀態</th>
                        <th>申請時間</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Requests != null && Model.Requests.Any())
                    {
                        foreach (var req in Model.Requests)
                        {
                            <tr class="text-center">
                                <td class="td-id">#@req.Id</td>
                                <td class="td-type">@req.LeaveTypeName</td>
                                <td class="td-date">@req.StartDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="td-date">@req.EndDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="td-duration">@req.HoursUsed.ToString("0.#")h / @req.DaysUsed.ToString("0.#")d</td>
                                <td>
                                    @await Html.PartialAsync("_LeaveStatusBadge", req.Status)
                                </td>
                                <td class="td-time">@req.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    <button type="button" class="btn-action btn-action--view"
                                            data-toggle="modal" data-target="#detailModal-@req.Id">
                                        <i class="bx bx-show"></i> 詳情
                                    </button>
                                    @if (req.CanCancel)
                                    {
                                        <button type="button" class="btn-action btn-action--cancel"
                                                data-toggle="modal" data-target="#cancelModal-@req.Id">
                                            <i class="bx bx-x"></i> 取消
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-state__icon"><i class="bx bx-inbox"></i></div>
                                    <div class="empty-state__text">目前沒有請假申請記錄</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Detail Modals -->
@if (Model.Requests != null)
{
    foreach (var req in Model.Requests)
    {
        <div class="modal fade" id="detailModal-@req.Id" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bx bx-detail" style="color: var(--warm-accent-dark)"></i>
                            請假申請詳情 <span style="opacity:.5">#@req.Id</span>
                        </h5>
                        <button type="button" class="close" data-dismiss="modal">
                            <span>&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-borderless detail-table">
                                    <tr><th>申請人</th><td>@req.EmployeeName</td></tr>
                                    <tr><th>部門</th><td>@req.DepartmentName</td></tr>
                                    <tr><th>假別</th><td>@req.LeaveTypeName</td></tr>
                                    <tr><th>請假日期</th><td>@req.StartDate.ToString("yyyy/MM/dd HH:mm") ~ @req.EndDate.ToString("yyyy/MM/dd HH:mm")</td></tr>
                                    <tr><th>時數</th><td>@req.HoursUsed.ToString("0.#") 小時（@req.DaysUsed.ToString("0.#") 天）</td></tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-borderless detail-table">
                                    <tr><th>請假原因</th><td>@(req.Reason ?? "-")</td></tr>
                                    <tr><th>代理人</th><td>@(req.DelegateName ?? "未指定")</td></tr>
                                    <tr>
                                        <th>狀態</th>
                                        <td>@await Html.PartialAsync("_LeaveStatusBadge", req.Status)</td>
                                    </tr>
                                    @if (req.ApproverName != null)
                                    {
                                        <tr><th>審核人</th><td>@req.ApproverName</td></tr>
                                        <tr><th>審核時間</th><td>@req.ApprovedAt?.ToString("yyyy/MM/dd HH:mm")</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(req.RejectReason))
                                    {
                                        <tr>
                                            <th style="color:#dc3545">駁回原因</th>
                                            <td style="color:#dc3545">@req.RejectReason</td>
                                        </tr>
                                    }
                                    @if (req.Status == "CancelPending")
                                    {
                                        <tr>
                                            <th style="color:#e67700">取消原因</th>
                                            <td>@req.CancelReason</td>
                                        </tr>
                                        <tr><th>取消申請時間</th><td>@req.CancelRequestedAt?.ToString("yyyy/MM/dd HH:mm")</td></tr>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-modal-close" data-dismiss="modal">關閉</button>
                    </div>
                </div>
            </div>
        </div>

        @* Cancel Modal *@
        @if (req.CanCancel)
        {
            <div class="modal fade" id="cancelModal-@req.Id" tabindex="-1" role="dialog">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <form asp-action="CancelRequest" method="post">
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    <i class="bx bx-x-circle" style="color:#dc3545"></i>
                                    取消請假申請 <span style="opacity:.5">#@req.Id</span>
                                </h5>
                                <button type="button" class="close" data-dismiss="modal">
                                    <span>&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p style="margin-bottom:16px; color: var(--warm-text-soft)">
                                    確定要取消此假單嗎？取消後需經主管審核。
                                </p>
                                <div class="form-group" style="margin-bottom:0">
                                    <label class="form-label" style="font-size:.85rem; font-weight:600">
                                        取消原因 <span style="color:#dc3545">*</span>
                                    </label>
                                    <textarea name="cancelReason" class="form-control" rows="3"
                                              style="border-radius:10px; border-color: rgba(165,104,29,0.15)"
                                              placeholder="請輸入取消原因..." required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-modal-close" data-dismiss="modal">返回</button>
                                <button type="submit" class="btn-modal-danger">
                                    <i class="bx bx-x"></i> 確認取消
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}

@section scripts {
<script>
    $(function () {
        // Tab-style filter: click a tab → set hidden input → submit form
        $('.filter-tab').on('click', function (e) {
            e.preventDefault();
            var status = $(this).data('status');
            $('#hiddenStatusFilter').val(status);
            // Update active state visually before submit
            $('.filter-tab').removeClass('active');
            $(this).addClass('active');
            $('#filterForm').submit();
        });
    });
</script>
}
