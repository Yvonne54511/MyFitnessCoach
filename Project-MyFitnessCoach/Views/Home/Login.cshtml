@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>MyFitnessCoach - 登入</title>

    <!-- Custom fonts for this template-->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .demo-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }
        .demo-buttons .btn {
            font-size: 0.75rem;
            padding: 0.3rem 0.6rem;
        }
    </style>
</head>

<body class="bg-gradient-primary">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">MyFitnessCoach 登入</h1>
                            </div>
                            <form class="user" method="post" asp-controller="Home" asp-action="Login">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-user"
                                           id="txtAccount" name="account"
                                           placeholder="請輸入帳號">
                                    <!-- Demo 快速登入按鈕 -->
                                    <div class="demo-buttons">
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="quickLogin('huqingwei12','123456')">角色-營養師</button>
                                        <button type="button" class="btn btn-outline-success btn-sm" onclick="quickLogin('gaoqingxing26','123456')">角色-採購人員</button>
                                        <button type="button" class="btn btn-outline-info btn-sm" onclick="quickLogin('zhaoyuqing36','123456')">角色-行銷人員</button>
                                        <button type="button" class="btn btn-outline-warning btn-sm" onclick="quickLogin('chenzhiming1','123456')">角色-採購主管</button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="quickLogin('admin1','123456')">角色-系統管理員</button>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <input type="password" class="form-control form-control-user"
                                           id="txtPassword" name="password"
                                           placeholder="請輸入密碼">
                                </div>
                                <button type="submit" class="btn btn-primary btn-user btn-block">
                                    登入
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Core plugin JavaScript-->
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="~/js/sb-admin-2.min.js"></script>

    <script>
        function quickLogin(account, password) {
            document.getElementById('txtAccount').value = account;
            document.getElementById('txtPassword').value = password;
            document.querySelector('form.user').submit();
        }
    </script>

</body>

</html>
