@using Project_MyFitnessCoach.Models.ViewModels
@model SalaryDetailViewModel

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-primary">@Model.InstructorName 的薪資明細 <small class="text-muted">(@Model.Year 年 @Model.Month 月)</small></h4>
            <span class="badge bg-success fs-6">時薪：$@Model.HourWage</span>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>日期</th>
                        <th>時段</th>
                        <th class="text-center">狀態</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Shifts.Any())
                    {
                        @foreach (var shift in Model.Shifts)
                        {
                            <tr>
                                <td>@shift.Date.ToString("yyyy-MM-dd")</td>
                                <td>@shift.TimeSlot</td>
                                <td class="text-center">
                                    @if (shift.IsBooked)
                                    {
                                        <span class="badge bg-danger">已預約</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">未預約</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">本月無排班紀錄</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 border-top pt-4">
            <div class="row text-end">
                <div class="col-md-8 text-muted align-self-center">
                    共計 @Model.Shifts.Count 堂課
                </div>
                <div class="col-md-4">
                    <h3 class="mb-0">總金額: <span class="text-danger">@Model.TotalSalary.ToString("C0")</span></h3>
                </div>
            </div>
        </div>
    </div>
</div>
