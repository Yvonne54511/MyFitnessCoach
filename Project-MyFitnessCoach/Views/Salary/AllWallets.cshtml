@model List<Project_MyFitnessCoach.Models.ViewModels.SalaryInstructorViewModel>

@{
    ViewData["Title"] = "教練薪資錢包總覽";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>教練薪資錢包總覽</h5>
            <div class="d-flex gap-2">
                <a asp-action="ExportToExcel" class="btn btn-sm btn-success">
                    <i class="fas fa-file-excel me-1"></i> 匯出明細 Excel
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-light">
                    <i class="fas fa-calculator me-1"></i> 返回薪資試算
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">教練資訊</th>
                            <th class="text-end">錢包餘額</th>
                            <th class="text-center">最後更新</th>
                            <th class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;" alt="@item.Name">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user text-white"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold">@item.Name</div>
                                            <small class="text-muted">ID: @item.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-primary pe-4">
                                    $@item.WalletBalance.ToString("N0")
                                </td>
                                <td class="text-center text-muted small">
                                    @(item.LastUpdated == DateTime.MinValue ? "無紀錄" : item.LastUpdated.ToString("yyyy/MM/dd HH:mm"))
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-secondary" onclick="loadWalletDetail(@item.Id)" data-bs-toggle="modal" data-bs-target="#salaryDetailModal">
                                        <i class="fas fa-history me-1"></i> 錢包明細
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Salary Detail Modal -->
<div class="modal fade" id="salaryDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white py-3 px-4 border-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-wallet me-2 text-warning"></i>教練錢包交易明細</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="modal-content">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">正在讀取交易紀錄...</p>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-content { overflow: hidden; }
    .bg-soft-success { background-color: #e1f5ea; color: #1cc88a; }
    .bg-soft-primary { background-color: #e8eeff; color: #4e73df; }
    .icon-box-sm { width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.9rem; }
    .history-item-row:hover { background-color: #f8f9fc; }
</style>

@section Scripts {
    <script>
        function loadWalletDetail(instructorId) {
            $('#modal-content').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">載入中...</p></div>');
            
            $.get('@Url.Action("GetWalletDetail", "Salary")', { 
                instructorId: instructorId
            }, function (data) {
                $('#modal-content').html(data);
            }).fail(function () {
                $('#modal-content').html('<div class="alert alert-danger">載入失敗，請稍後再試。</div>');
            });
        }
    </script>
}
