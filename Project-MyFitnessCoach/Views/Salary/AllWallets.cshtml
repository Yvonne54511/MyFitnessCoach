@model List<Project_MyFitnessCoach.Models.ViewModels.SalaryInstructorViewModel>

@{
    ViewData["Title"] = "教練薪資錢包總覽";
}

@section styles {
    <!-- 僅在此頁面引入 Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* 修正與 BS4 導覽列的衝突 */
        .card-header h5 { font-size: 1.25rem; }
        .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.875rem; }
        .collapse:not(.show) { display: none; }
        .bg-soft-success { background-color: #e1f5ea; color: #1cc88a; }
        .bg-soft-primary { background-color: #e8eeff; color: #4e73df; }
        .icon-box-sm { width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.9rem; }
        .history-item-row:hover { background-color: #f8f9fc; }
    </style>
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white"><i class="fas fa-list me-2"></i>教練薪資錢包總覽</h5>
            <div class="d-flex gap-2">
                <a asp-action="ExportToExcel" class="btn btn-sm btn-success">
                    <i class="fas fa-file-excel me-1"></i> 匯出明細 Excel
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-light">
                    <i class="fas fa-calculator me-1"></i> 返回薪資試算
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">教練資訊</th>
                            <th class="text-end">錢包餘額</th>
                            <th class="text-center">最後更新</th>
                            <th class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;" alt="@item.Name">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user text-white"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@item.Name</div>
                                            <small class="text-muted">ID: @item.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-primary pe-4">
                                    $@item.WalletBalance.ToString("N0")
                                </td>
                                <td class="text-center text-muted small">
                                    @(item.LastUpdated == DateTime.MinValue ? "無紀錄" : item.LastUpdated.ToString("yyyy/MM/dd HH:mm"))
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-info" type="button" 
                                            data-bs-toggle="collapse" data-bs-target="#details-@item.Id" 
                                            aria-expanded="false" aria-controls="details-@item.Id"
                                            onclick="loadWalletDetail(@item.Id)">
                                        <i class="fas fa-history me-1"></i> 錢包明細
                                    </button>
                                </td>
                            </tr>
                            <tr class="p-0 border-0">
                                <td colspan="4" class="p-0 border-0">
                                    <div id="details-@item.Id" class="collapse" data-bs-parent="tbody">
                                        <div class="card card-body border-0 bg-light p-0 detail-container" style="border-radius: 0;">
                                            <div class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status"></div>
                                                <p class="mt-2 text-muted">正在讀取交易紀錄...</p>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 引入 Bootstrap 5 JS Bundle (含 Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function loadWalletDetail(instructorId) {
            const $container = $('#details-' + instructorId + ' .detail-container');
            
            // 如果已經載入過且不是正在讀取狀態，就不重複載入
            if ($container.data('loaded')) return;

            $.get('@Url.Action("GetWalletDetail", "Salary")', { 
                instructorId: instructorId
            }, function (data) {
                $container.html(data);
                $container.data('loaded', true);
            }).fail(function () {
                $container.html('<div class="alert alert-danger m-3">載入失敗，請稍後再試。</div>');
            });
        }
    </script>
}
