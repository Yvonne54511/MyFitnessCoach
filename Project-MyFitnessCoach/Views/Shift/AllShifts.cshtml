@using Project_MyFitnessCoach
@using Project_MyFitnessCoach.Models
@using Project_MyFitnessCoach.Models.DTOs
@using Project_MyFitnessCoach.Models.ViewModels
@model IEnumerable<AllShiftsViewModel>

@{
    ViewData["Title"] = "所有營養師排班表";
    var instructors = ViewBag.Instructors as List<InstructorDto>;
    var criteria = ViewBag.Criteria as ShiftQueryCriteria;
}

@section Styles {
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <style>
        #shiftsTable thead th {
            color: white !important;
            background-color: #343a40 !important;
        }
    </style>
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="row mb-3 text-center">
        <div class="col">
            <h2><i class='bx bx-calendar-check'></i> @ViewData["Title"]</h2>
            <p class="text-muted">此頁面僅供管理員查看並管理所有營養師的排班時段。</p>
        </div>
    </div>

    <!-- Filter Form - Full Width to match table -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="filterForm" method="get" asp-action="AllShifts" class="row g-3 justify-content-center align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class='bx bx-user-voice'></i> 營養師</label>
                    <select name="InstructorId" class="form-select live-filter">
                        <option value="">-- 全部 --</option>
                        @if (instructors != null)
                        {
                            foreach (var instructor in instructors)
                            {
                                <option value="@instructor.InstructorId" selected="@(criteria?.InstructorId == instructor.InstructorId)">
                                    @instructor.InstructorName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold"><i class='bx bx-calendar-event'></i> 開始日期</label>
                    <input type="date" name="StartDate" class="form-control live-filter" value="@(criteria?.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold"><i class='bx bx-calendar-event'></i> 結束日期</label>
                    <input type="date" name="EndDate" class="form-control live-filter" value="@(criteria?.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold"><i class='bx bx-check-shield'></i> 預約狀態</label>
                    <select name="IsBooked" class="form-select live-filter">
                        <option value="">-- 全部 --</option>
                        <option value="true" selected="@(criteria?.IsBooked == true)">已預約</option>
                        <option value="false" selected="@(criteria?.IsBooked == false)">開放中</option>
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <a asp-action="AllShifts" class="btn btn-outline-secondary w-100">
                        <i class='bx bx-reset'></i> 重置
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-body" id="tableContainer">
            @* 初始載入表格 *@
            @await Html.PartialAsync("_AllShiftsTable", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize DataTable function
            function initDataTable() {
                if ($.fn.DataTable.isDataTable('#shiftsTable')) {
                    $('#shiftsTable').DataTable().destroy();
                }
                $('#shiftsTable').DataTable({
                    "order": [[ 1, "asc" ]], // Default sort by date
                    "searching": false, // Disable search bar
                    "columnDefs": [
                        { "orderable": false, "targets": 4 }
                    ],
                    "language": {
                        "processing": "處理中...",
                        "loadingRecords": "載入中...",
                        "lengthMenu": "每頁顯示 _MENU_ 筆",
                        "zeroRecords": "沒有符合的結果",
                        "info": "顯示第 _START_ 至 _END_ 筆，共 _TOTAL_ 筆資料",
                        "infoEmpty": "顯示第 0 至 0 筆，共 0 筆資料",
                        "infoFiltered": "(從 _MAX_ 筆資料中過濾)",
                        "search": "搜尋:",
                        "paginate": {
                            "first": "第一頁",
                            "previous": "上一頁",
                            "next": "下一頁",
                            "last": "最後一頁"
                        }
                    },
                    "dom": "<'row mb-2'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                           "<'row'<'col-sm-12'tr>>" +
                           "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
                });
            }

            // Initial call
            initDataTable();

            // 1. 防止表單預設提交行為
            $('#filterForm').on('submit', function(e) {
                e.preventDefault();
                updateTable();
            });

            // 2. 即時篩選功能
            $('.live-filter').on('change', function() {
                updateTable();
            });

            function updateTable() {
                var formData = $('#filterForm').serialize();
                $.ajax({
                    url: '@Url.Action("AllShifts", "Shift")',
                    type: 'GET',
                    data: formData,
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function(html) {
                        $('#tableContainer').html(html);
                        initDataTable(); // Re-initialize after AJAX update
                    },
                    error: function() {
                        console.error('篩選請求失敗');
                    }
                });
            }

            // 3. 更改預約狀態功能 (使用事件委派)
            $(document).on('change', '.status-updater', function() {
                var shiftId = $(this).data('shift-id');
                var isBooked = $(this).val() === 'true';
                var $select = $(this);
                var originalValue = !isBooked;

                Swal.fire({
                    title: '確定要更改預約狀態嗎？',
                    text: "這將會直接影響前端顯示！",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '是的，更改它',
                    cancelButtonText: '取消'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("UpdateShiftStatus", "Shift")', { shiftId: shiftId, isBooked: isBooked }, function(res) {
                            if (res.success) {
                                Swal.fire('更新成功！', '', 'success');
                                // 更新 badge
                                var badgeHtml = isBooked ? 
                                    '<span class="badge bg-danger">已預約</span>' : 
                                    '<span class="badge bg-success">開放中</span>';
                                $('#status-badge-' + shiftId).html(badgeHtml);
                            } else {
                                Swal.fire('錯誤', res.message || '更新失敗', 'error');
                                $select.val(originalValue.toString());
                            }
                        }).fail(function() {
                            Swal.fire('錯誤', '網路請求失敗', 'error');
                            $select.val(originalValue.toString());
                        });
                    } else {
                        $select.val(originalValue.toString());
                    }
                });
            });
        });
    </script>
}
