@model Project_MyFitnessCoach.Models.ViewModels.SensitiveWordViewModel

@{
    ViewData["Title"] = "新增敏感字詞";
}

<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">新增敏感字詞</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">敏感字詞資料</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Word" class="control-label">敏感字詞</label>
                    <input asp-for="Word" class="form-control" placeholder="請輸入欲過濾之敏感字詞" />
                    <span asp-validation-for="Word" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> 儲存
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-undo"></i> 返回列表
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
