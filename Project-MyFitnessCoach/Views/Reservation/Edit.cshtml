@model Project_MyFitnessCoach.Models.ViewModels.ReservationViewModel

@{
    ViewData["Title"] = "預約詳細資訊";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">預約詳細資訊 - @Model.ScheduleDate.ToString("yyyy-MM-dd") (@Model.TimeSlot)</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">客戶名稱:</div>
                        <div class="col-sm-9">@Model.MemberName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">預約目標:</div>
                        <div class="col-sm-9">@Model.Target</div>
                    </div>
                    <hr />
                    
                    @if (ViewBag.IsEditable == false)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> 此預約日期已超過五天，無法修改備註。
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Memorandum" class="form-label fw-bold">備註 (Memorandum):</label>
                            @if (ViewBag.IsEditable == false)
                            {
                                <textarea asp-for="Memorandum" class="form-control" rows="5" readonly></textarea>
                            }
                            else
                            {
                                <textarea asp-for="Memorandum" class="form-control" rows="5" placeholder="輸入您對此預約的紀錄或備註..."></textarea>
                            }
                            <span asp-validation-for="Memorandum" class="text-danger"></span>
                            <div class="form-text text-muted">此欄位僅供營養師紀錄，客戶端不會看到 (最多 100 字)。</div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 返回列表
                            </a>
                            @if (ViewBag.IsEditable != false)
                            {
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> 儲存變更
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
