@using Project_MyFitnessCoach
@using Project_MyFitnessCoach.Models
@using Project_MyFitnessCoach.Models.ViewModels
@model IEnumerable<ReservationViewModel>

@{
    ViewData["Title"] = "預約班表";
}

@section Styles {
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
    <style>
        .table thead th {
            color: white !important;
            background-color: #343a40 !important;
        }
    </style>
}

<div class="container mt-4">
    

    <div class="row mb-3">
        <div class="col">
            <h2><i class='bx bx-calendar-event'></i> @ViewData["Title"]</h2>
        </div>
    </div>

    <!-- 篩選表單 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">開始日期</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">結束日期</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class='bx bx-search-alt'></i> 篩選
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class='bx bx-reset'></i> 重置
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class='bx bx-check-circle me-2'></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="reservationTable">
                    <thead class="table-dark text-white">
                        <tr class="text-center">
                            <th>日期</th>
                            <th>時段</th>
                            <th>預約客戶</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var shift in Model.OrderBy(s => s.ScheduleDate).ThenBy(s => s.TimeSlot))
                            {
                                <tr class="text-center">
                                    <td>@shift.ScheduleDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @{
                                            string badgeClass = "bg-secondary";
                                            string customStyle = "color: white;";
                                            if (shift.TimeSlot.Contains("早")) { badgeClass = "bg-warning text-dark"; customStyle = ""; }
                                            else if (shift.TimeSlot.Contains("午")) { badgeClass = ""; customStyle = "background-color: #FF8C00; color: white;"; }
                                            else if (shift.TimeSlot.Contains("晚")) { badgeClass = ""; customStyle = "background-color: #00008B; color: white;"; }
                                        }
                                        <span class="badge @badgeClass" style="@customStyle">
                                            @shift.TimeSlot
                                        </span>
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(shift.MemberName) ? "未知客戶" : shift.MemberName)
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@shift.Id" class="btn btn-sm btn-outline-primary">
                                            <i class='bx bx-info-circle'></i> 詳細資訊
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="text-center">
                                <td colspan="4" class="text-center text-muted">目前暫無被預約的時段</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-controller="Shift" asp-action="Index" class="btn btn-secondary">
            <i class='bx bx-arrow-back'></i> 返回排班表單
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#reservationTable').DataTable({
                "order": [[ 0, "desc" ]],
                "columnDefs": [
                    { "orderable": false, "targets": 3 }
                ],
                "language": {
                    "processing": "處理中...",
                    "loadingRecords": "載入中...",
                    "lengthMenu": "顯示 _MENU_ 項結果",
                    "zeroRecords": "沒有符合的結果",
                    "info": "顯示第 _START_ 至 _END_ 項結果，共 _TOTAL_ 項",
                    "infoEmpty": "顯示第 0 至 0 項結果，共 0 項",
                    "infoFiltered": "(從 _MAX_ 項結果中過濾)",
                    "search": "搜尋:",
                    "paginate": {
                        "first": "第一頁",
                        "previous": "上一頁",
                        "next": "下一頁",
                        "last": "最後一頁"
                    }
                }
            });
        });
    </script>
}
