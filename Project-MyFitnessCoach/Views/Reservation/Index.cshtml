@using Project_MyFitnessCoach
@using Project_MyFitnessCoach.Models
@using Project_MyFitnessCoach.Models.ViewModels
@model IEnumerable<ReservationViewModel>

@{
    ViewData["Title"] = "預約班表";
}

<div class="container mt-4">
    

    <div class="row mb-3">
        <div class="col">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- 篩選表單 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">開始日期</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">結束日期</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> 篩選
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> 重置
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th>日期</th>
                            <th>時段</th>
                            <th>預約客戶</th>
                            <th>狀態</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var shift in Model.OrderBy(s => s.ScheduleDate).ThenBy(s => s.TimeSlot))
                            {
                                <tr class="text-center">
                                    <td>@shift.ScheduleDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @{
                                            string badgeClass = "bg-secondary";
                                            string customStyle = "color: white;";
                                            if (shift.TimeSlot.Contains("早")) { badgeClass = "bg-warning text-dark"; customStyle = ""; }
                                            else if (shift.TimeSlot.Contains("午")) { badgeClass = ""; customStyle = "background-color: #FF8C00; color: white;"; }
                                            else if (shift.TimeSlot.Contains("晚")) { badgeClass = ""; customStyle = "background-color: #00008B; color: white;"; }
                                        }
                                        <span class="badge @badgeClass" style="@customStyle">
                                            @shift.TimeSlot
                                        </span>
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(shift.MemberName) ? "未知客戶" : shift.MemberName)
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">已預約</span>
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@shift.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-info-circle"></i> 詳細資訊
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="text-center">
                                <td colspan="5" class="text-center text-muted">目前暫無被預約的時段</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-controller="Shift" asp-action="Index" class="btn btn-secondary">返回排班表單</a>
    </div>
</div>
