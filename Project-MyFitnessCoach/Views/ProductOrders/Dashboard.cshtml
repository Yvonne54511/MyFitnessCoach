@using Project_MyFitnessCoach.Models.ViewModels
@model ProductOrderDashboardViewModel
@{
    ViewData["Title"] = "訂單統計看板";
}

<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">訂單管理看板</h1>
    </div>

    <!-- Content Row (Top 1/3: 3 Cards) -->
    <div class="row">

        <!-- 本月總訂單量 Card -->
        <div class="col-xl-4 col-md-6 mb-4">
            <a asp-controller="ProductOrders" asp-action="Index" class="text-decoration-none">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    本月總訂單量</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalOrdersThisMonth.ToString("N0")</div>
                                <div class="mt-2 mb-0 text-muted text-xs">
                                    @if (Model.TotalOrdersChangePercentage >= 0)
                                    {
                                        <span class="text-success mr-2"><i class="fa fa-arrow-up"></i> @Model.TotalOrdersChangePercentage%</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger mr-2"><i class="fa fa-arrow-down"></i> @Math.Abs(Model.TotalOrdersChangePercentage)%</span>
                                    }
                                    <span>與上月相比</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-calendar fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- 待處理訂單 Card -->
        <div class="col-xl-4 col-md-6 mb-4">
            <a asp-controller="ProductOrders" asp-action="Index" asp-route-status="1" class="text-decoration-none">
                <div class="card border-left-danger shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                    待處理訂單</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingActionCount.ToString("N0")</div>
                                <div class="mt-2 mb-0 text-muted text-xs">
                                    <span class="text-primary mr-1">待出貨: @Model.PendingShipmentCount</span>
                                    <span class="mx-1">|</span>
                                    <span class="text-warning ml-1">退貨: @Model.DisputedCount</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-tasks fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- City Distribution Card -->
        <div class="col-xl-4 col-md-12 mb-4">
            <div class="card shadow h-100 mb-4">
                <!-- Card Header - Dropdown -->
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-info text-uppercase">縣市分布</h6>
                    <div class="dropdown no-arrow">
                        <a class="dropdown-toggle" href="#" role="button" id="cityDropdownLink"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                             aria-labelledby="cityDropdownLink">
                            <div class="dropdown-header">銷售統計 (全部縣市)</div>
                            @foreach (var city in Model.CityDistributions)
                            {
                                <div class="dropdown-item d-flex justify-content-between align-items-center">
                                    <span>@city.City</span>
                                    <span class="badge badge-info badge-pill ml-2">@city.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <!-- Card Body -->
                <div class="card-body">
                    <div class="chart-pie" style="height: 250px; position: relative;">
                        <canvas id="cityDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row (Middle: Trend and Category Ranking) -->
    <div class="row">
        <!-- Left: Order Trend Chart (2/3 width) -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">最近 14 天訂單趨勢</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 350px; position: relative;">
                        <canvas id="orderTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Category Ranking (1/3 width, Moved Up) -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">熱銷商品類別排行</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar" style="height: 290px; position: relative;">
                        <canvas id="categoryRankingChart"></canvas>
                    </div>
                    <div class="mt-4 small">
                        <ul class="list-group list-group-flush">
                            @foreach (var cat in Model.CategoryRankings.Take(3))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center p-2">
                                    <span>@cat.CategoryName</span>
                                    <span class="badge badge-info badge-pill">@cat.TotalSold</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <!-- Page level plugins -->
    <script src="~/vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script>
        // Set new default font family and font color to mimic Bootstrap's default styling
        Chart.defaults.global.defaultFontFamily = 'Nunito', '-apple-system,system-ui,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif';
        Chart.defaults.global.defaultFontColor = '#858796';

        function number_format(number, decimals, dec_point, thousands_sep) {
            number = (number + '').replace(',', '').replace(' ', '');
            var n = !isFinite(+number) ? 0 : +number,
                prec = !isFinite(+decimals) ? 0 : Math.abs(decimals),
                sep = (typeof thousands_sep === 'undefined') ? ',' : thousands_sep,
                dec = (typeof dec_point === 'undefined') ? '.' : dec_point,
                s = '',
                toFixedFix = function(n, prec) {
                    var k = Math.pow(10, prec);
                    return '' + Math.round(n * k) / k;
                };
            s = (prec ? toFixedFix(n, prec) : '' + Math.round(n)).split('.');
            if (s[0].length > 3) {
                s[0] = s[0].replace(/\B(?=(?:\d{3})+(?!\d))/g, sep);
            }
            if ((s[1] || '').length < prec) {
                s[1] = s[1] || '';
                s[1] += new Array(prec - s[1].length + 1).join('0');
            }
            return s.join(dec);
        }

        // --- Order Trend Chart ---
        var trendLabels = @Html.Raw(Json.Serialize(Model.OrderTrends.Select(t => t.Date)));
        var trendData = @Html.Raw(Json.Serialize(Model.OrderTrends.Select(t => t.Count)));

        var ctxTrend = document.getElementById("orderTrendChart");
        var myLineChart = new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: "訂單數",
                    lineTension: 0.3,
                    backgroundColor: "rgba(78, 115, 223, 0.05)",
                    borderColor: "rgba(78, 115, 223, 1)",
                    pointRadius: 3,
                    pointBackgroundColor: "rgba(78, 115, 223, 1)",
                    pointBorderColor: "rgba(78, 115, 223, 1)",
                    pointHoverRadius: 3,
                    pointHoverBackgroundColor: "rgba(78, 115, 223, 1)",
                    pointHoverBorderColor: "rgba(78, 115, 223, 1)",
                    pointHitRadius: 10,
                    pointBorderWidth: 2,
                    data: trendData,
                }],
            },
            options: {
                maintainAspectRatio: false,
                responsive: true,
                layout: { padding: { left: 10, right: 25, top: 25, bottom: 0 } },
                scales: {
                    xAxes: [{ gridLines: { display: false, drawBorder: false }, ticks: { maxTicksLimit: 7 } }],
                    yAxes: [{
                        ticks: { maxTicksLimit: 5, padding: 10, beginAtZero: true, callback: function(value) { return number_format(value); } },
                        gridLines: { color: "rgb(234, 236, 244)", zeroLineColor: "rgb(234, 236, 244)", drawBorder: false, borderDash: [2], zeroLineBorderDash: [2] }
                    }],
                },
                legend: { display: false },
                tooltips: {
                    backgroundColor: "rgb(255,255,255)", bodyFontColor: "#858796", titleMarginBottom: 10, titleFontColor: '#6e707e', titleFontSize: 14,
                    borderColor: '#dddfeb', borderWidth: 1, xPadding: 15, yPadding: 15, displayColors: false, intersect: false, mode: 'index', caretPadding: 10,
                    callbacks: { label: function(tooltipItem, chart) { return chart.datasets[tooltipItem.datasetIndex].label + ': ' + number_format(tooltipItem.yLabel); } }
                }
            }
        });

        // --- City Distribution Chart (Pie style) ---
        var cityLabels = @Html.Raw(Json.Serialize(Model.CityDistributions.Select(c => c.City)));
        var cityData = @Html.Raw(Json.Serialize(Model.CityDistributions.Select(c => c.Count)));

        var ctxCity = document.getElementById("cityDistributionChart");
        var myPieChart = new Chart(ctxCity, {
            type: 'pie',
            data: {
                labels: cityLabels,
                datasets: [{
                    data: cityData,
                    backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796', '#5a5c69', '#2e59d9', '#17a673', '#2c9faf'],
                    hoverBackgroundColor: ['#2e59d9', '#17a673', '#2c9faf', '#dda20a', '#be2617', '#60616f', '#373840', '#1c45c3', '#13855c', '#258391'],
                    hoverBorderColor: "rgba(234, 236, 244, 1)",
                }],
            },
            options: {
                maintainAspectRatio: false,
                tooltips: {
                    backgroundColor: "rgb(255,255,255)",
                    bodyFontColor: "#858796",
                    borderColor: '#dddfeb',
                    borderWidth: 1,
                    xPadding: 15,
                    yPadding: 15,
                    displayColors: false,
                    caretPadding: 10,
                },
                legend: {
                    display: false
                },
            },
        });

        // --- Category Ranking Chart (New Horizontal Bar) ---
        var catLabels = @Html.Raw(Json.Serialize(Model.CategoryRankings.Select(c => c.CategoryName)));
        var catData = @Html.Raw(Json.Serialize(Model.CategoryRankings.Select(c => c.TotalSold)));

        var ctxCat = document.getElementById("categoryRankingChart");
        var myBarChart = new Chart(ctxCat, {
            type: 'horizontalBar',
            data: {
                labels: catLabels,
                datasets: [{
                    label: "銷售數量",
                    backgroundColor: "#36b9cc",
                    hoverBackgroundColor: "#2c9faf",
                    borderColor: "#36b9cc",
                    data: catData,
                }],
            },
            options: {
                maintainAspectRatio: false,
                responsive: true,
                scales: {
                    xAxes: [{
                        ticks: { beginAtZero: true, precision: 0 },
                        gridLines: { display: false, drawBorder: false }
                    }],
                    yAxes: [{
                        gridLines: { display: false, drawBorder: false }
                    }],
                },
                legend: { display: false },
                tooltips: {
                    backgroundColor: "rgb(255,255,255)", bodyFontColor: "#858796", borderColor: '#dddfeb', borderWidth: 1, xPadding: 10, yPadding: 10, displayColors: false, caretPadding: 10,
                },
            }
        });
    </script>
}
