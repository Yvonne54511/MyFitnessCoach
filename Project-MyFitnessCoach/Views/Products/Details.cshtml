@model Project_MyFitnessCoach.Models.ViewModels.ProductIndexItemViewModel

@{
    ViewData["Title"] = "產品詳情";
}

<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">產品詳情</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">產品資訊 (ID: @Model.Id)</h6>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info btn-sm shadow-sm">
                    <i class="fas fa-edit fa-sm text-white-50"></i> 編輯
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                    }
                    else
                    {
                        <div class="bg-light p-5 rounded">
                            <i class="fas fa-image fa-3x text-gray-300"></i>
                            <p class="mt-2 text-gray-500">無圖片</p>
                        </div>
                    }
                    <div class="mt-3">
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-success px-3 py-2">啟用中</span>
                        }
                        else
                        {
                            <span class="badge badge-danger px-3 py-2">已下架</span>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CategoryName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.CategoryName)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OriginalPrice)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.OriginalPrice)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UnitPrice)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.UnitPrice)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SortOrder)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.SortOrder)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
                        <dd class="col-sm-9">
                            <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "無描述" : Model.Description)</p>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="form-group mt-4 border-top pt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left fa-sm text-white-50"></i> 返回列表
                </a>
            </div>
        </div>
    </div>

</div>
