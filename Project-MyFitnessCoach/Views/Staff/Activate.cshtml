@model Project_MyFitnessCoach.Models.ViewModel.StaffActivateViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>帳號啟用 | MyFitnessCoach</title>
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/Login.css" rel="stylesheet">
    <style>
        body{
            background-color: #ffe3b3
        }
        .activate-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            /* background-color: #f8f9fc; */
        }
        .activate-card {
            width: 100%;
            max-width: 500px;
            padding: 2rem;
            border-radius: 1rem;
            background: white;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
    </style>
</head>
<body >
    <div class="activate-container">
        <div class="activate-card">
            <div class="text-center mb-4">
                <h1 class="h4 text-gray-900 font-weight-bold">MyFitnessCoach後台帳號啟用</h1>
                <p class="text-muted">請設定您的登入帳號與密碼</p>
            </div>
            <form asp-action="Activate" method="post">
                <input type="hidden" asp-for="Code" />
                <div class="form-group">
                    <label asp-for="Account"></label>
                    <input asp-for="Account" class="form-control" placeholder="請設定帳號" />
                    <span asp-validation-for="Account" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="請設定密碼 (至少 6 碼)" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="請再次輸入密碼" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-block py-2 mt-4">完成設定並啟用帳號</button>
            </form>
        </div>
    </div>
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
