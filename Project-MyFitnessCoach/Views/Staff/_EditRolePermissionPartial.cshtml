@model Project_MyFitnessCoach.Models.ViewModels.EditRolePermissionViewModel

<form id="editRolePermissionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.RoleId" />
    
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">編輯角色權限與人員 - @RoleDisplayHelper.ToDisplayName(Model.RoleName)</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    
    <div class="modal-body">
        <div class="row">
            <!-- 功能選擇 -->
            <div class="col-md-6 border-right">
                <h6><i class="fas fa-tasks mr-2"></i>功能權限</h6>
                <div style="max-height: 400px; overflow-y: auto;">
                    @foreach (var func in Model.AllFunctions.Where(f => f.IsActive))
                    {
                        <div class="custom-control custom-checkbox mb-2">
                            <input type="checkbox" class="custom-control-input" id="func_@func.Id" 
                                   name="functionIds" value="@func.Id" 
                                   @(Model.SelectedFunctionIds.Contains(func.Id) ? "checked" : "")>
                            <label class="custom-control-label" for="func_@func.Id">
                                @func.FunctionName
                                <br/><small class="text-muted">@func.Description</small>
                            </label>
                        </div>
                    }
                </div>
            </div>
            
            <!-- 人員選擇 -->
            <div class="col-md-6">
                <h6><i class="fas fa-users mr-2"></i>角色人員</h6>
                <div style="max-height: 400px; overflow-y: auto;">
                    @foreach (var staff in Model.AllStaff.Where(s => s.IsActive))
                    {
                        <div class="custom-control custom-checkbox mb-2">
                            <input type="checkbox" class="custom-control-input" id="user_@staff.Id" 
                                   name="userIds" value="@staff.Id" 
                                   @(Model.SelectedUserIds.Contains(staff.Id) ? "checked" : "")>
                            <label class="custom-control-label" for="user_@staff.Id">
                                @staff.UserName
                                <br/><small class="text-muted">@staff.Email</small>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
        <button type="button" class="btn btn-primary" onclick="submitRolePermissions()">儲存更新</button>
    </div>
</form>
