@model IEnumerable<Project_MyFitnessCoach.Models.ViewModel.StaffListItemViewModel>
@{
    ViewData["Title"] = "使用者帳號管理";
    var roles = ViewBag.Roles as IEnumerable<Project_MyFitnessCoach.Models.EfModels.Role>;
    var instructorList = ViewBag.InstructorList as List<Project_MyFitnessCoach.Models.ViewModel.StaffListItemViewModel>;
    var memberList = ViewBag.MemberList as List<Project_MyFitnessCoach.Models.ViewModel.StaffListItemViewModel>;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">員工管理</h1>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <ul class="nav nav-tabs card-header-tabs" id="managementTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="staff-tab" data-toggle="tab" href="#staffTab" role="tab" aria-controls="staffTab" aria-selected="true">員工列表</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="instructor-tab" data-toggle="tab" href="#instructorTab" role="tab" aria-controls="instructorTab" aria-selected="false">營養師列表</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="member-tab" data-toggle="tab" href="#memberTab" role="tab" aria-controls="memberTab" aria-selected="false">會員列表</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content" id="managementTabContent">
                <div class="tab-pane fade show active" id="staffTab" role="tabpanel" aria-labelledby="staff-tab">
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#inviteModal">
                            <i class="fas fa-plus"></i> 邀請新員工
                        </button>
                    </div>
                    <div id="staffListContainer">
                        @await Html.PartialAsync("_StaffListPartial", Model)
                    </div>
                </div>
                <div class="tab-pane fade" id="instructorTab" role="tabpanel" aria-labelledby="instructor-tab">
                    <div id="instructorListContainer">
                        @await Html.PartialAsync("_InstructorCollapsiblePartial", instructorList ?? new List<Project_MyFitnessCoach.Models.ViewModel.StaffListItemViewModel>())
                    </div>
                </div>
                <div class="tab-pane fade" id="memberTab" role="tabpanel" aria-labelledby="member-tab">
                    <div id="memberListContainer">
                        @await Html.PartialAsync("_StaffListNoRolePartial", memberList ?? new List<Project_MyFitnessCoach.Models.ViewModel.StaffListItemViewModel>())
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 邀請 Modal -->
<div class="modal fade" id="inviteModal" tabindex="-1" role="dialog" aria-labelledby="inviteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="inviteForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="inviteModalLabel">邀請新員工</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>員工姓名</label>
                        <input name="UserName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>電子郵件</label>
                        <input name="Email" type="email" class="form-control" required />
                    </div>
                    @* <div class="form-group">
                        <label>分配角色</label>
                        <div class="mt-2">
                            @{
                                var roleMapping = new Dictionary<string, string>
                                {
                                    
                                    { "instructor", "營養師" },
                                    { "purchasor", "採購人員" },
                                    { "marketor", "行銷人員" },
                                    { "admin", "系統管理員" }
                                };
                            }
                            @foreach (var role in roles)
                            {
                                <div class="custom-control custom-checkbox custom-control-inline">
                                    <input type="checkbox" class="custom-control-input" id="role_@role.Id" name="RoleIds" value="@role.Id">
                                    <label class="custom-control-label" for="role_@role.Id">@(roleMapping.ContainsKey(role.RoleName) ? roleMapping[role.RoleName] : role.RoleName)</label>
                                </div>
                            }
                        </div>
                    </div> *@
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                    <button class="btn btn-primary" type="submit">送出邀請</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 編輯 Modal -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="editModalContent">
            <!-- 由 PartialView 填充 -->
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // 提交邀請表單
            $('#inviteForm').submit(function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("Invite", "Staff")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            $('#inviteModal').modal('hide');
                            $('#inviteForm')[0].reset();
                            refreshList();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("發生錯誤：" + xhr.status + " " + error);
                    }
                });
            });

            // 打開編輯 Modal
            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                $.get('@Url.Action("Edit", "Staff")/' + id, function (html) {
                    $('#editModalContent').html(html);
                    $('#editModal').modal('show');
                }).fail(function (xhr) {
                    alert("載入編輯資料失敗：" + xhr.status);
                });
            });

            // 提交編輯表單
            $(document).on('submit', '#editForm', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("Edit", "Staff")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            $('#editModal').modal('hide');
                            refreshList();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("發生錯誤：" + xhr.status + " " + error);
                    }
                });
            });

            // 刪除按鈕
            $(document).on('click', '.btn-delete', function () {
                if (confirm('確定要刪除這位員工嗎？')) {
                    var id = $(this).data('id');
                    $.ajax({
                        url: '@Url.Action("Delete", "Staff")/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                alert(response.message);
                                refreshList();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function (xhr, status, error) {
                            alert("刪除失敗：" + xhr.status + " " + error);
                        }
                    });
                }
            });

            function refreshList() {
                $.get('@Url.Action("GetStaffList", "Staff")', function (html) {
                    $('#staffListContainer').html(html);
                });
            }

            // === 營養師操作 ===

            // 編輯營養師
            $(document).on('click', '.btn-edit-instructor', function (e) {
                e.stopPropagation();
                var id = $(this).data('id');
                $.get('@Url.Action("EditInstructor", "Staff")/' + id, function (html) {
                    $('#instructorModalContainer').html(html);
                    $('#editModal').modal('show');
                }).fail(function (xhr) {
                    alert("載入編輯資料失敗：" + xhr.status);
                });
            });

            // 刪除營養師
            $(document).on('click', '.btn-delete-instructor', function (e) {
                e.stopPropagation();
                if (confirm('確定要刪除這位營養師嗎？這將會移除其營養師身份。')) {
                    var id = $(this).data('id');
                    $.ajax({
                        url: '@Url.Action("DeleteInstructor", "Staff")',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            } else {
                                alert(result.message);
                            }
                        }
                    });
                }
            });

            // 切換營養師狀態
            $(document).on('change', '.toggle-instructor-active', function (e) {
                e.stopPropagation();
                var id = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("ToggleInstructorActive", "Staff")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result.success) {
                            alert(result.message);
                        } else {
                            alert(result.message);
                        }
                    }
                });
            });

            // 新增營養師
            window.showCreateInstructorModal = function () {
                $.get('@Url.Action("CreateInstructor", "Staff")', function (html) {
                    $('#instructorModalContainer').html(html);
                    $('#createModal').modal('show');
                }).fail(function (xhr) {
                    alert("載入新增表單失敗：" + xhr.status);
                });
            };

            // 營養師 row hover 效果
            $(document).on('mouseenter', '.instructor-row', function () {
                $(this).addClass('bg-light');
            }).on('mouseleave', '.instructor-row', function () {
                $(this).removeClass('bg-light');
            });
        });
    </script>
}
