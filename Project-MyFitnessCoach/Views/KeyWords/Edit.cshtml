@model Project_MyFitnessCoach.Models.ViewModels.KeyWordViewModel

@{
    ViewData["Title"] = "編輯關鍵字詞";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class='bx bx-edit-alt'></i> 編輯關鍵字詞</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Word" class="control-label"></label>
                            <input asp-for="Word" class="form-control" />
                            <span asp-validation-for="Word" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Category" class="control-label"></label>
                            <select asp-for="Category" class="form-control">
                                <option value="1">正向 (1)</option>
                                <option value="0">中性 (0)</option>
                                <option value="-1">負向 (-1)</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Weight" class="control-label"></label>
                            <input asp-for="Weight" class="form-control" type="number" />
                            <span asp-validation-for="Weight" class="text-danger"></span>
                        </div>
                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class='bx bx-save'></i> 更新
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-block">
                                <i class='bx bx-undo'></i> 返回列表
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}