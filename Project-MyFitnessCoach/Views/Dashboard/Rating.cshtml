@model Project_MyFitnessCoach.Models.ViewModels.InstructorRatingViewModel
@{
    ViewData["Title"] = "營養師評分統計 Dashboard";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 d-inline-block mr-3">評論區 Dashboard</h1>
            <div class="btn-group shadow-sm" role="group">
                <a asp-action="Rating" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" class="btn btn-primary active border-right">
                    <i class="fas fa-star-half-alt mr-1"></i> 營養師評分統計
                </a>
                <a asp-action="KeyWordAnalytics" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" class="btn btn-white text-primary border-right">
                    <i class="fas fa-search mr-1"></i> 評論字詞分析
                </a>
                <button type="button" class="btn btn-white text-info" data-toggle="modal" data-target="#rankingModal">
                    <i class="fas fa-trophy mr-1 text-warning"></i> 查看排名
                </button>
            </div>
        </div>
    </div>

    <partial name="_DashboardFilter" model="Model" />

    <!-- 排名 Modal -->
    <div class="modal fade" id="rankingModal" tabindex="-1" role="dialog" aria-labelledby="rankingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header bg-gradient-info text-white border-0 py-3">
                    <h5 class="modal-title font-weight-bold" id="rankingModalLabel">
                        <i class="fas fa-crown mr-2"></i> 營養師人氣王排名
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body bg-light p-4">
                    <!-- Tab Navigation -->
                    <ul class="nav nav-pills nav-justified mb-4 shadow-sm bg-white p-1" style="border-radius: 12px;" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active font-weight-bold" id="monthly-tab" data-toggle="tab" href="#monthly-rank" role="tab" aria-controls="monthly-rank" aria-selected="true">
                                <i class="far fa-calendar-alt mr-1"></i> 當月排名 (@(Model.SelectedMonth == 0 ? "累計" : Model.SelectedMonth + "月"))
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold text-warning" id="yearly-tab" data-toggle="tab" href="#yearly-rank" role="tab" aria-controls="yearly-rank" aria-selected="false">
                                <i class="fas fa-trophy mr-1"></i> 當年排名 (@(Model.SelectedYear)年度)
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <!-- Monthly Tab -->
                        <div class="tab-pane fade show active" id="monthly-rank" role="tabpanel" aria-labelledby="monthly-tab">
                            <div id="kahoot-podium" class="d-flex align-items-end justify-content-center mb-5" style="height: 300px;">
                                <!-- JS 動態渲染 -->
                            </div>
                            <div id="ranking-list-container">
                                <div class="table-responsive">
                                    <table class="table table-hover border-0">
                                        <thead class="bg-white">
                                            <tr>
                                                <th class="border-0 text-muted small text-uppercase">排名</th>
                                                <th class="border-0 text-muted small text-uppercase">營養師</th>
                                                <th class="border-0 text-muted small text-uppercase text-center">平均評分</th>
                                                <th class="border-0 text-muted small text-uppercase text-center">總評論數</th>
                                            </tr>
                                        </thead>
                                        <tbody id="ranking-table-body">
                                            <!-- JS 動態渲染 -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Yearly Tab -->
                        <div class="tab-pane fade" id="yearly-rank" role="tabpanel" aria-labelledby="yearly-tab">
                            <div id="yearly-podium" class="d-flex align-items-end justify-content-center mb-5" style="height: 300px;">
                                <!-- JS 動態渲染 -->
                            </div>
                            <div id="yearly-ranking-list-container">
                                <div class="table-responsive">
                                    <table class="table table-hover border-0">
                                        <thead class="bg-white">
                                            <tr>
                                                <th class="border-0 text-muted small text-uppercase">排名</th>
                                                <th class="border-0 text-muted small text-uppercase">營養師</th>
                                                <th class="border-0 text-muted small text-uppercase text-center">年度評分</th>
                                                <th class="border-0 text-muted small text-uppercase text-center">年度評論數</th>
                                            </tr>
                                        </thead>
                                        <tbody id="yearly-ranking-table-body">
                                            <!-- JS 動態渲染 -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 營養師評論佔比圖表區 -->
    <div class="row">
        <!-- 圓餅圖：評論佔比 -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">評論數量佔比</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="instructorDistributionPieChart"></canvas>
                    </div>
                    <div class="mt-4 text-center small">
                        <span class="mr-2"><i class="fas fa-circle text-primary"></i> 總評論數比例</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 長條圖：情緒對比 -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">營養師語意情緒對比 (堆疊長條圖)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar" style="height: 320px;">
                        <canvas id="instructorSentimentBarChart"></canvas>
                    </div>
                    <hr>
                    <div class="small text-muted">
                        <i class="fas fa-info-circle mr-1"></i> 提示：此圖表顯示混合模型判定後的結果。綠色為正評，灰色為中立，紅色為負評。
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 數據概覽卡片 -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">全體總評論數</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.GlobalRating.TotalReviews 則</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-comments fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">全體平均得分</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.GlobalRating.AverageRating.ToString("0.0") / 5.0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-star fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 詳細資訊區域 (初始隱藏) -->
    <div id="instructor-detail-container" class="row d-none">
        <div class="col-12">
            <h4 class="h4 mb-3 text-gray-800 border-bottom pb-2">詳細評分資訊：<span id="selected-instructor-name" class="text-primary"></span></h4>
        </div>
        @foreach (var instructor in Model.InstructorRatings)
        {
            <div class="col-xl-12 col-lg-12 mb-4 instructor-card" id="card-instructor-@instructor.InstructorId" style="display:none;">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-3 text-center border-right">
                                <div class="display-3 text-warning font-weight-bold">@instructor.AverageRating.ToString("0.0")</div>
                                <div class="text-muted">平均得分</div>
                                <div class="mt-2 h4">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(instructor.AverageRating))
                                        {
                                            <i class="fas fa-star text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-warning"></i>
                                        }
                                    }
                                </div>
                                <div class="mt-3">
                                    <span class="badge badge-pill badge-primary px-3">總計 @instructor.TotalReviews 則評論</span>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <h5 class="font-weight-bold mb-4">星等分佈百分比</h5>
                                @{
                                    var stars = new[] { 
                                        new { Label = "5 星", Count = instructor.Star5Count, Color = "bg-success" },
                                        new { Label = "4 星", Count = instructor.Star4Count, Color = "bg-primary" },
                                        new { Label = "3 星", Count = instructor.Star3Count, Color = "bg-info" },
                                        new { Label = "2 星", Count = instructor.Star2Count, Color = "bg-warning" },
                                        new { Label = "1 星", Count = instructor.Star1Count, Color = "bg-danger" }
                                    };
                                }
                                @foreach (var star in stars)
                                {
                                    var percentage = instructor.TotalReviews > 0 ? (double)star.Count / instructor.TotalReviews * 100 : 0;
                                    <div class="mb-3">
                                        <div class="small font-weight-bold">
                                            @star.Label <span class="float-right text-muted">@star.Count 則 (@percentage.ToString("0.0")%)</span>
                                        </div>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @star.Color" role="progressbar" 
                                                 style="width: @(percentage)%" 
                                                 aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }

                                <h5 class="font-weight-bold mt-4 mb-4">語意情感分析 (星星基礎分 + 關鍵字加權)</h5>
                                <div class="accordion accordion-flush sentiment-accordion" id="sentimentAccordion-@instructor.InstructorId">
                                    @{
                                        var sentimentGroups = new[] { 
                                            new { Label = "正評 (Positive)", Id = "Pos", Count = instructor.PositiveCount, Reviews = instructor.PositiveReviews, Color = "success", Icon = "fa-smile" },
                                            new { Label = "中立 (Neutral)", Id = "Neu", Count = instructor.NeutralCount, Reviews = instructor.NeutralReviews, Color = "secondary", Icon = "fa-meh" },
                                            new { Label = "負評 (Negative)", Id = "Neg", Count = instructor.NegativeCount, Reviews = instructor.NegativeReviews, Color = "danger", Icon = "fa-frown" }
                                        };
                                    }

                                    @foreach (var group in sentimentGroups)
                                    {
                                        var percentage = instructor.TotalReviews > 0 ? (double)group.Count / instructor.TotalReviews * 100 : 0;
                                        <div class="accordion-item border-bottom">
                                            <h2 class="accordion-header mb-0" id="heading-@group.Id-@instructor.InstructorId">
                                                <button class="btn btn-link btn-block text-left d-flex justify-content-between align-items-center text-decoration-none py-3 px-2 collapsed" 
                                                        type="button" data-toggle="collapse" 
                                                        data-target="#collapse-@group.Id-@instructor.InstructorId" 
                                                        aria-expanded="false" 
                                                        aria-controls="collapse-@group.Id-@instructor.InstructorId">
                                                    <span class="font-weight-bold text-@group.Color">
                                                        <i class="fas @group.Icon mr-2"></i> @group.Label
                                                        <span class="badge badge-@group.Color badge-pill ml-2">@group.Count</span>
                                                    </span>
                                                    <span class="text-muted small">
                                                        @percentage.ToString("0.0")% <i class="fas fa-chevron-down ml-2 accordion-arrow"></i>
                                                    </span>
                                                </button>
                                            </h2>
                                            <div id="collapse-@group.Id-@instructor.InstructorId" class="collapse" 
                                                 aria-labelledby="heading-@group.Id-@instructor.InstructorId" 
                                                 data-parent="#sentimentAccordion-@instructor.InstructorId">
                                                <div class="accordion-body bg-light p-0 review-scroll-container">
                                                    @if (group.Reviews != null && group.Reviews.Any())
                                                    {
                                                        <div class="list-group list-group-flush shadow-sm">
                                                            @foreach (var review in group.Reviews)
                                                            {
                                                                <div class="list-group-item list-group-item-action border-0 mb-1">
                                                                    <div class="d-flex w-100 justify-content-between mb-1">
                                                                        <h6 class="mb-1 font-weight-bold">@review.MemberName</h6>
                                                                        <small class="text-muted">@review.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                                                    </div>
                                                                    <div class="mb-1">
                                                                        @for (int i = 1; i <= 5; i++)
                                                                        {
                                                                            if (i <= review.Rating)
                                                                            {
                                                                                <i class="fas fa-star text-warning"></i>
                                                                            }
                                                                            else
                                                                            {
                                                                                <i class="far fa-star text-warning"></i>
                                                                            }
                                                                        }
                                                                        @{
                                                                            var scoreColor = review.CalculatedScore > 0 ? "success" : (review.CalculatedScore < 0 ? "danger" : "secondary");
                                                                        }
                                                                        <span class="badge badge-@scoreColor border ml-2 p-1 px-2" style="font-size: 0.85rem;">
                                                                            最終得分: @(review.CalculatedScore > 0 ? "+" : "")@review.CalculatedScore
                                                                        </span>
                                                                    </div>
                                                                    <p class="mb-1 text-gray-800">@(string.IsNullOrEmpty(review.Comment) ? "(未填寫評論內容)" : review.Comment)</p>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="p-4 text-center text-muted">
                                                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                                            目前無此類別的評論
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        /* 模擬 Bootstrap 5 Accordion Flush 效果 */
        .accordion-flush .accordion-item {
            background-color: transparent;
            border-right: 0;
            border-left: 0;
            border-radius: 0;
        }
        .accordion-flush .accordion-item:first-child { border-top: 0; }
        .accordion-flush .accordion-item:last-child { border-bottom: 0; }
        
        .sentiment-accordion .btn-link {
            color: #4e73df;
            transition: background-color 0.2s;
        }
        .sentiment-accordion .btn-link:hover {
            background-color: rgba(0,0,0,0.03);
            text-decoration: none;
        }
        .sentiment-accordion .btn-link:focus {
            box-shadow: none;
        }
        
        .accordion-arrow {
            transition: transform 0.3s ease;
        }
        .btn-link:not(.collapsed) .accordion-arrow {
            transform: rotate(180deg);
        }
        
        .list-group-item {
            transition: background-color 0.2s;
        }
        .list-group-item:hover {
            background-color: #f8f9fc !important;
        }
        
        .review-scroll-container {
            max-height: 400px;
            overflow-y: auto;
            scrollbar-width: thin;
        }
        
        .review-scroll-container::-webkit-scrollbar {
            width: 6px;
        }
        
        .review-scroll-container::-webkit-scrollbar-thumb {
            background-color: #dddfeb;
            border-radius: 3px;
        }

        /* 排名相關樣式 */
        .podium-item {
            flex: 1;
            margin: 0 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.3s ease;
        }
        .podium-item:hover {
            transform: translateY(-10px);
        }
        .podium-block {
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            border-radius: 10px 10px 0 0;
            padding-top: 20px;
            color: white;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            position: relative;
        }
        .podium-block::after {
            content: attr(data-rank);
            font-size: 4rem;
            opacity: 0.3;
            position: absolute;
            bottom: 10px;
        }
        .rank-1 .podium-block { height: 200px; background: linear-gradient(135deg, #f6c23e 0%, #dda20a 100%); }
        .rank-2 .podium-block { height: 160px; background: linear-gradient(135deg, #aab2bd 0%, #858796 100%); }
        .rank-3 .podium-block { height: 120px; background: linear-gradient(135deg, #cd7f32 0%, #a05a2c 100%); }
        
        .podium-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 4px solid white;
            background-color: #eee;
            margin-bottom: 15px;
            object-fit: cover;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .rank-1 .podium-avatar { width: 90px; height: 90px; margin-top: -45px; border-color: #f6c23e; }
        .rank-2 .podium-avatar { margin-top: -35px; border-color: #858796; }
        .rank-3 .podium-avatar { margin-top: -35px; border-color: #cd7f32; }
        
        .podium-name { font-weight: bold; color: #4e73df; margin-bottom: 5px; text-align: center; }
        .podium-score { font-size: 1.2rem; font-weight: 800; color: #5a5c69; }
        
        .crown-icon {
            position: absolute;
            top: -30px;
            font-size: 1.5rem;
            color: #f6c23e;
            filter: drop-shadow(0 2px 2px rgba(0,0,0,0.2));
        }
    </style>
}

@section Scripts {
    <script src="~/vendor/chart.js/Chart.min.js"></script>
    <script>
        // Set Chart.js default style
        Chart.defaults.global.defaultFontFamily = 'Nunito', '-apple-system,system-ui,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif';
        Chart.defaults.global.defaultFontColor = '#858796';

        // Prepare data for Monthly and Yearly
        var instructorData = @Html.Raw(Json.Serialize(Model.InstructorRatings));
        var yearlyInstructorData = @Html.Raw(Json.Serialize(Model.YearlyInstructorRatings));
        
        var sortedInstructors = [...instructorData].sort((a, b) => b.totalScore - a.totalScore);
        var sortedYearlyInstructors = [...yearlyInstructorData].sort((a, b) => b.totalScore - a.totalScore);

        // Listen for Modal events
        $('#rankingModal').on('show.bs.modal', function () {
            renderRanking('monthly');
            renderRanking('yearly');
        });

        function renderRanking(type) {
            var data = (type === 'monthly') ? sortedInstructors : sortedYearlyInstructors;
            var podiumId = (type === 'monthly') ? '#kahoot-podium' : '#yearly-podium';
            var tableId = (type === 'monthly') ? '#ranking-table-body' : '#yearly-ranking-table-body';
            var scoreLabel = (type === 'monthly') ? '當月總分' : '年度總分';
            
            var podiumHtml = '';
            var tableHtml = '';
            
            // Top 3 Podium
            var top3 = data.slice(0, 3);
            var podiumOrder = [1, 0, 2]; // 2nd, 1st, 3rd
            
            podiumOrder.forEach(idx => {
                var inst = top3[idx];
                if (inst) {
                    var rankNum = idx + 1;
                    var rankClass = 'rank-' + rankNum;
                    podiumHtml += `
                        <div class="podium-item ${rankClass}" onclick="jumpToDetail(${inst.instructorId}, '${inst.instructorName}')" style="cursor:pointer;">
                            <div class="podium-name">${inst.instructorName}</div>
                            <div class="podium-score">${inst.totalScore} 分</div>
                            <div class="podium-block" data-rank="${rankNum}">
                                ${rankNum === 1 ? '<i class="fas fa-crown crown-icon"></i>' : ''}
                                <img src="${inst.imageUrl || '/img/undraw_profile.svg'}" class="podium-avatar shadow">
                            </div>
                        </div>
                    `;
                }
            });
            $(podiumId).html(podiumHtml);

            // Full List
            data.forEach((inst, index) => {
                var rankNum = index + 1;
                var medal = '';
                if (rankNum === 1) medal = '<i class="fas fa-medal text-warning"></i>';
                else if (rankNum === 2) medal = '<i class="fas fa-medal text-secondary"></i>';
                else if (rankNum === 3) medal = '<i class="fas fa-medal text-danger"></i>';

                tableHtml += `
                    <tr onclick="jumpToDetail(${inst.instructorId}, '${inst.instructorName}')" style="cursor:pointer;">
                        <td class="font-weight-bold">${medal} ${rankNum}</td>
                        <td>
                            <img src="${inst.imageUrl || '/img/undraw_profile.svg'}" class="rounded-circle mr-2" width="30" height="30" style="object-fit:cover;">
                            ${inst.instructorName}
                        </td>
                        <td class="text-center">
                            <span class="badge badge-warning px-3 py-2" style="font-size: 1rem;">${inst.totalScore} 分</span>
                        </td>
                        <td class="text-center text-muted">${inst.totalReviews}</td>
                    </tr>
                `;
            });
            $(tableId).html(tableHtml);
        }

        function jumpToDetail(id, name) {
            $('#rankingModal').modal('hide');
            showInstructorDetail(id, name);
        }

        // 準備圖表資料
        var instructorLabels = @Html.Raw(Json.Serialize(Model.InstructorRatings.Select(i => i.InstructorName)));
        var instructorCounts = @Html.Raw(Json.Serialize(Model.InstructorRatings.Select(i => i.TotalReviews)));
        var instructorIds = @Html.Raw(Json.Serialize(Model.InstructorRatings.Select(i => i.InstructorId)));
        
        // 情感分析資料
        var posData = @Html.Raw(Json.Serialize(Model.InstructorRatings.Select(i => i.PositiveCount)));
        var neuData = @Html.Raw(Json.Serialize(Model.InstructorRatings.Select(i => i.NeutralCount)));
        var negData = @Html.Raw(Json.Serialize(Model.InstructorRatings.Select(i => i.NegativeCount)));

        // 圓餅圖配置
        var ctxPie = document.getElementById("instructorDistributionPieChart");
        var myPieChart = new Chart(ctxPie, {
          type: 'pie',
          data: {
            labels: instructorLabels,
            datasets: [{
              data: instructorCounts,
              backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796', '#5a5c69', '#2e59d9', '#17a673', '#2c9faf'],
              hoverBorderColor: "rgba(234, 236, 244, 1)",
            }],
          },
          options: {
            maintainAspectRatio: false,
            tooltips: {
              backgroundColor: "rgb(255,255,255)",
              bodyFontColor: "#858796",
              borderColor: '#dddfeb',
              borderWidth: 1,
              xPadding: 15,
              yPadding: 15,
              displayColors: true,
              caretPadding: 10,
            },
            legend: {
              display: false
            },
            onClick: function(evt, activeElements) {
                if (activeElements.length > 0) {
                    var index = activeElements[0]._index;
                    showInstructorDetail(instructorIds[index], instructorLabels[index]);
                }
            }
          },
        });

        // 長條圖配置 (堆疊長條圖)
        var ctxBar = document.getElementById("instructorSentimentBarChart");
        var myBarChart = new Chart(ctxBar, {
          type: 'bar',
          data: {
            labels: instructorLabels,
            datasets: [
              {
                label: '正評 (Positive)',
                backgroundColor: "#1cc88a",
                hoverBackgroundColor: "#17a673",
                borderColor: "#1cc88a",
                data: posData,
              },
              {
                label: '中立 (Neutral)',
                backgroundColor: "#858796",
                hoverBackgroundColor: "#717384",
                borderColor: "#858796",
                data: neuData,
              },
              {
                label: '負評 (Negative)',
                backgroundColor: "#e74a3b",
                hoverBackgroundColor: "#be2617",
                borderColor: "#e74a3b",
                data: negData,
              }
            ],
          },
          options: {
            maintainAspectRatio: false,
            layout: {
              padding: { left: 10, right: 25, top: 25, bottom: 0 }
            },
            scales: {
              xAxes: [{
                stacked: true,
                gridLines: { display: false, drawBorder: false },
                ticks: { maxTicksLimit: 15 },
                maxBarThickness: 25,
              }],
              yAxes: [{
                stacked: true,
                ticks: {
                  min: 0,
                  maxTicksLimit: 5,
                  padding: 10,
                },
                gridLines: {
                  color: "rgb(234, 236, 244)",
                  zeroLineColor: "rgb(234, 236, 244)",
                  drawBorder: false,
                  borderDash: [2],
                  zeroLineBorderDash: [2]
                }
              }],
            },
            legend: { display: true, position: 'bottom' },
            tooltips: {
              titleMarginBottom: 10,
              titleFontColor: '#6e707e',
              titleFontSize: 14,
              backgroundColor: "rgb(255,255,255)",
              bodyFontColor: "#858796",
              borderColor: '#dddfeb',
              borderWidth: 1,
              xPadding: 15,
              yPadding: 15,
              displayColors: true,
              caretPadding: 10,
            },
            onClick: function(evt, activeElements) {
                if (activeElements.length > 0) {
                    var index = activeElements[0]._index;
                    showInstructorDetail(instructorIds[index], instructorLabels[index]);
                }
            }
          }
        });

        // 顯示特定營養師資料的函式
        function showInstructorDetail(id, name) {
            // 顯示容器
            $('#instructor-detail-container').removeClass('d-none');
            $('#selected-instructor-name').text(name);
            
            // 隱藏所有卡片，顯示選中的那張
            $('.instructor-card').hide();
            $('#card-instructor-' + id).fadeIn();
            
            // 平滑滾動到詳細資訊區
            $('html, body').animate({
                scrollTop: $("#instructor-detail-container").offset().top - 100
            }, 500);
        }
    </script>
}
